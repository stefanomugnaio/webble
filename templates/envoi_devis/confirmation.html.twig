{# templates/devis/confirmation.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Demande de devis envoyée{% endblock %}

{% block body %}
<section class="py-5 min-vh-100 margin-top-responsive" style="background:#f8f9fa;">
    <div class="container py-4 py-lg-5">

        <div class="row justify-content-center">
            <div class="col-lg-7">

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-md-5 text-center">

                        <div class="mb-4">
                            <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
                        </div>

                        <h1 class="h4 fw-semibold text-dark mb-3">
                            Votre demande de devis a bien été envoyée
                        </h1>

                        <p class="text-secondary mb-4">
                            Je vous recontacte rapidement par email ou téléphone pour parler de votre projet
                            <strong>
                                {% if offre.prix_site_ht is not null %}
                                    (offre {{ offre.libelle }} – {{ offre.prix_site_ht|number_format(0, ',', ' ') }} € HT)
                                {% else %}
                                    (offre {{ offre.libelle }})
                                {% endif %}
                            </strong>.
                        </p>

                        <div class="border rounded-4 bg-light p-3 small text-secondary mb-4">
                            Vous pouvez entre-temps préparer quelques exemples de sites que vous aimez,
                            ou une liste des fonctionnalités dont vous avez besoin : cela nous fera gagner du temps
                            lors de notre premier échange.
                        </div>

                        <div class="d-flex flex-column flex-md-row justify-content-center gap-3">

                            <a href="{{ path('app_index') }}"
                               class="btn btn-primary rounded-pill px-4">
                                Retour à la page d'accueil
                            </a>

                            <a href="{{ path('app_contact') }}"
                               class="btn btn-outline-secondary rounded-pill px-4">
                                Me contacter pour une question
                            </a>

                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</section>
{% endblock %}