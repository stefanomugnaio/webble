{# templates/devis/confirmation.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Contrat de maintenance{% endblock %}

{% block body %}
<section class="py-5 min-vh-100 margin-top-responsive" style="background:#f8f9fa;">
    <div class="container py-4 py-lg-5">

        <div class="text-center mx-auto mb-5" style="max-width:720px;">
            <p class="text-uppercase small fw-semibold text-secondary mb-2" style="letter-spacing:.08em;">
                Maintenance
            </p>

            <h1 class="fw-semibold text-dark mb-3">
                Contrat de maintenance
            </h1>

            <p class="text-secondary mb-0">
                Le contrat de maintenance vous permet de garder un site web fiable,
                sécurisé et toujours à jour.
            </p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-lg-5">

                        <h2 class="h5 fw-semibold text-dark mb-4">
                            Ce que comprend le contrat
                        </h2>

                        <ul class="list-unstyled text-secondary mb-4">

                            <li class="d-flex mb-2">
                                <span class="me-2">🔐</span>
                                <span><strong>Sécurité et mises à jour</strong> pour protéger votre site contre les failles</span>
                            </li>

                            <li class="d-flex mb-2">
                                <span class="me-2">🛡️</span>
                                <span>Surveillance et corrections en cas de dysfonctionnement</span>
                            </li>

                            <li class="d-flex mb-2">
                                <span class="me-2">🐞</span>
                                <span>Correction de bugs mineurs affectant le fonctionnement du site</span>
                            </li>

                            <li class="d-flex mb-2">
                                <span class="me-2">✏️</span>
                                <span>Modifications mineures de contenu (textes, images, informations)</span>
                            </li>

                            <li class="d-flex mb-2">
                                <span class="me-2">🗑️</span>
                                <span>Suppression ou mise à jour de contenus existants</span>
                            </li>

                            <li class="d-flex mb-2">
                                <span class="me-2">⚙️</span>
                                <span>Ajustements simples pour améliorer des fonctionnalités existantes</span>
                            </li>

                            <li class="d-flex mb-2">
                                <span class="me-2">📊</span>
                                <span>Vérification régulière du bon fonctionnement et des performances</span>
                            </li>

                            <li class="d-flex mb-2">
                                <span class="me-2">💾</span>
                                <span>Sauvegardes régulières pour restaurer le site en cas de problème</span>
                            </li>

                            <li class="d-flex mb-2">
                                <span class="me-2">📞</span>
                                <span>Assistance et support en cas de question technique</span>
                            </li>

                            <li class="d-flex">
                                <span class="me-2">💶</span>
                                <span>Tarif préférentiel sur les développements spécifiques</span>
                            </li>

                        </ul>

                        <div class="border rounded-4 bg-light p-3 small text-secondary">
                            Le contrat de maintenance ne comprend pas la création de nouvelles fonctionnalités,
                            les évolutions majeures du site ou les refontes complètes.
                        </div>

                    </div>
                </div>

                <div class="text-center mt-4">
                    <a href="{{ path('app_creation_site') }}" class="btn btn-outline-secondary rounded-pill px-4">
                        Retour aux offres
                    </a>
                </div>

            </div>
        </div>

    </div>
</section>
{% endblock %}