{% extends 'base.html.twig' %}

{% block title %}Devis - {{ offre.libelle }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('envoi_devis') }}
{% endblock %}

{% block body %}
	<section class="py-5 min-vh-100 margin-top-responsive" style="background:#f8f9fa;">
		<div class="container py-4 py-lg-5">

			<div class="text-center mx-auto mb-5" style="max-width:760px;">
				<p class="text-uppercase small fw-semibold text-secondary mb-2" style="letter-spacing:.08em;">
					Demande de devis
				</p>

				<h1 class="fw-semibold text-dark mb-3">
					Offre {{ offre.libelle }}
				</h1>

				<p class="text-secondary mb-0">
					{{ offre.description }}
				</p>
			</div>

			{{ form_start(form, {
				attr: {
					id: 'contact-form',
					'data-recaptcha-site-key': recaptcha_site_key
				}
			}) }}

			<div class="row g-4 align-items-start">

				<div class="col-12 col-xl-7">

					<div class="card border-0 shadow-sm rounded-4 mb-4">
						<div class="card-body p-4 p-lg-5">

							<h5 class="fw-semibold text-dark mb-4">
								Vos coordonnées
							</h5>

							<div class="row g-3">

								<div class="col-md-6">
									{{ form_label(form.nom) }}
									{{ form_widget(form.nom) }}
									<div class="error-message">{{ form_errors(form.nom) }}</div>
								</div>

								<div class="col-md-6">
									{{ form_label(form.prenom) }}
									{{ form_widget(form.prenom) }}
									<div class="error-message">{{ form_errors(form.prenom) }}</div>
								</div>

								<div class="col-md-6">
									{{ form_label(form.email) }}
									{{ form_widget(form.email) }}
									<div class="error-message">{{ form_errors(form.email) }}</div>
								</div>

								<div class="col-md-6">
									{{ form_label(form.telephone) }}
									{{ form_widget(form.telephone) }}
									<div class="error-message">{{ form_errors(form.telephone) }}</div>
								</div>

								<div class="col-12">
									{{ form_label(form.adresse) }}
									{{ form_widget(form.adresse) }}
									<div class="error-message">{{ form_errors(form.adresse) }}</div>
								</div>

								<div class="col-md-6">
									{{ form_label(form.code_postal) }}
									{{ form_widget(form.code_postal) }}
									<div class="error-message">{{ form_errors(form.code_postal) }}</div>
								</div>

								<div class="col-md-6">
									{{ form_label(form.ville) }}
									{{ form_widget(form.ville) }}
									<div class="error-message">{{ form_errors(form.ville) }}</div>
								</div>

								<div class="col-12">
									{{ form_label(form.description) }}
									{{ form_widget(form.description) }}
									<div class="error-message">{{ form_errors(form.description) }}</div>
								</div>

							</div>
						</div>
					</div>

					<div class="card border-0 shadow-sm rounded-4 mb-4">
						<div class="card-body p-4 p-lg-5">

							<h5 class="fw-semibold text-dark mb-4">
								Ce que comprend l'offre {{ offre.libelle }}
							</h5>

							<ul class="list-unstyled text-secondary mb-0">
								{% for item in offre.caracteristiques %}
									<li class="d-flex mb-2">
										<i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
										<span>{{ item }}</span>
									</li>
								{% endfor %}
							</ul>

						</div>
					</div>

					<div class="col-12 mt-3">
						{{ form_widget(form.recaptchaToken) }}
					</div>

				</div>

				<div class="col-12 col-xl-5">

					<div class="card border-0 shadow-sm rounded-4 mb-4">
						<div class="card-body p-4">

							<h5 class="fw-semibold text-dark mb-4">
								Options
							</h5>

							<div class="border rounded-4 bg-light p-3 mb-3">
								<div class="form-check">
									{{ form_widget(form.contrat_maintenance, { attr: { class: 'form-check-input' } }) }}

									{{ form_label(
										form.contrat_maintenance,
										offre.webble_plus_libelle ~ ' (' ~ offre.webble_plus_prix_mensuel_ht|number_format(2, ',', ' ') ~ ' € / mois)',
										{ label_attr: { class: 'form-check-label ms-2 text-dark fw-medium' } }
									) }}
								</div>

								<p class="small text-secondary mt-2 mb-1">
									Abonnement mensuel séparé du devis de création.
								</p>

								{% if offre.webble_plus_mois_offerts > 0 %}
									<p class="small text-secondary mb-1">
										{{ offre.webble_plus_mois_offerts }} mois offerts avec cette offre,
										puis facturation à partir du {{ offre.webble_plus_premier_mois_facture }}e mois.
									</p>
								{% endif %}

								<p class="small text-secondary mt-2 mb-0">
									<a target="_blank" href="{{ path('app_cdm') }}">
										En savoir plus sur l'abonnement Webble+
									</a>
								</p>
							</div>

							<div class="border rounded-4 bg-light p-3 mb-3">
								<div class="form-check">
									{{ form_widget(form.domaine, { attr: { class: 'form-check-input' } }) }}

									{{ form_label(
										form.domaine,
										optionsDevis.nom_domaine.libelle ~ ' (' ~ optionsDevis.nom_domaine.prix_ht|number_format(2, ',', ' ') ~ ' € HT)',
										{ label_attr: { class: 'form-check-label ms-2 text-dark fw-medium' } }
									) }}
								</div>

								<p class="small text-secondary mt-2 mb-0">
									{{ optionsDevis.nom_domaine.description }}
								</p>
							</div>

							<div class="border rounded-4 bg-light p-3">
								<div class="form-check">
									{{ form_widget(form.hebergement, { attr: { class: 'form-check-input' } }) }}

									{{ form_label(
										form.hebergement,
										optionsDevis.hebergement.libelle ~ ' (' ~ optionsDevis.hebergement.prix_ht|number_format(2, ',', ' ') ~ ' € HT)',
										{ label_attr: { class: 'form-check-label ms-2 text-dark fw-medium' } }
									) }}
								</div>

								<p class="small text-secondary mt-2 mb-0">
									{{ optionsDevis.hebergement.description }}
								</p>
							</div>

						</div>
					</div>

					<div class="card border-0 shadow-sm rounded-4 mb-4">
						<div class="card-body p-4">

							<h5 class="fw-semibold text-dark mb-4">
								Récapitulatif
							</h5>

							{% if montants.site_ht is not null %}

								<script>
									window.devisRecapConfig = {{ configurationRecapitulatif|json_encode|raw }};
								</script>

								<div class="row mb-2">
									<div class="col-7 text-secondary small">Site web</div>
									<div class="col-5 text-end fw-semibold text-dark">
										{{ montants.site_ht|number_format(2, ',', ' ') }} €
									</div>
								</div>

								<div id="domaineRow" class="row mb-2 {% if not configurationRecapitulatif.options.domaine.active_par_defaut %}gray-row{% endif %}">
									<div class="col-7 text-secondary small">Nom de domaine</div>
									<div class="col-5 text-end fw-semibold text-dark" id="domaineAmount">
										{% if configurationRecapitulatif.options.domaine.active_par_defaut %}
											{{ configurationRecapitulatif.options.domaine.prix_ht|number_format(2, ',', ' ') }} €
										{% else %}
											0,00 €
										{% endif %}
									</div>
								</div>

								<div id="hebergementRow" class="row mb-3 {% if not configurationRecapitulatif.options.hebergement.active_par_defaut %}gray-row{% endif %}">
									<div class="col-7 text-secondary small">Hébergement</div>
									<div class="col-5 text-end fw-semibold text-dark" id="hebergementAmount">
										{% if configurationRecapitulatif.options.hebergement.active_par_defaut %}
											{{ configurationRecapitulatif.options.hebergement.prix_ht|number_format(2, ',', ' ') }} €
										{% else %}
											0,00 €
										{% endif %}
									</div>
								</div>

								<hr>

								<div class="row mb-2">
									<div class="col-6 text-secondary small">TVA</div>
									<div class="col-6 text-end fw-semibold text-dark" id="tvaAmount">
										{{ configurationRecapitulatif.totaux_par_defaut.total_tva|number_format(2, ',', ' ') }} €
									</div>
								</div>

								<div class="row">
									<div class="col-6 fw-semibold text-dark">
										Total création du site
									</div>

									<div class="col-6 text-end fw-bold fs-4 text-dark" id="totalTtc">
										{{ configurationRecapitulatif.totaux_par_defaut.total_ttc|number_format(2, ',', ' ') }} €
									</div>
								</div>

								<hr>

								<div id="webblePlusRow" class="row mb-2 gray-row">
									<div class="col-7 text-secondary small">
										Abonnement {{ offre.webble_plus_libelle }}
									</div>

									<div class="col-5 text-end fw-semibold text-dark" id="webblePlusAmount">
										Non souscrit
									</div>

									<div class="col-12 text-secondary mt-1" id="webblePlusInfo" style="font-size: 11px;">
										Non inclus dans le total du devis.
									</div>
								</div>

							{% endif %}

						</div>
					</div>

					<div class="card border-0 shadow-sm rounded-4 mb-4">
						<div class="card-body p-4">

							<div class="form-check d-flex align-items-start">
								{{ form_widget(form.rgpd, { attr: { class: 'form-check-input mt-1', required: true } }) }}

								<label class="form-check-label ms-2 text-dark">
									J’ai lu et j’accepte la
									<a href="{{ path('app_politique_confidentialite') }}" target="_blank" class="text-decoration-underline">
										politique de confidentialité
									</a>
									<span class="text-danger">*</span>
								</label>
							</div>

							<div class="error-message">{{ form_errors(form.rgpd) }}</div>

						</div>
					</div>

					<div class="d-grid gap-3">
						<a href="{{ path('app_creation_site') }}" class="btn btn-outline-secondary rounded-pill">
							Retour aux offres
						</a>

						<button type="submit" class="btn btn-primary rounded-pill">
							Envoyer la demande de devis
						</button>
					</div>

				</div>
			</div>

			{{ form_end(form) }}

		</div>
	</section>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="https://www.google.com/recaptcha/api.js?render={{ recaptcha_site_key }}"></script>
	{{ encore_entry_script_tags('envoi_devis') }}
{% endblock %}
