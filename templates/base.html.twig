<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">

		<meta
		name="viewport" content="width=device-width, initial-scale=1">

		{# URL absolue de la page, sans les paramètres de recherche. #}
		{% set urlCanoniqueParDefaut = app.request
            ? app.request.schemeAndHttpHost ~ app.request.baseUrl ~ app.request.pathInfo
            : 'https://webble.fr/'
        %}

		{# ================= TITRE ET DESCRIPTION ================= #}
		<title>
			{% block title %}Création de sites internet sur mesure
			{% endblock %}
			{% block suffixe_titre %}
				| Webble
			{% endblock %}
		</title>

		<meta name="description" content="{% block description_seo %}Conception de sites internet modernes à petit prix, performants et adaptés aux besoins des indépendants, entreprises et associations.{% endblock %}">

		<meta name="author" content="Webble">
		<meta
		name="application-name" content="Webble">

		{# Contrôle l’indexation et autorise les aperçus enrichis. #}
		<meta name="robots" content="{% block robots_seo %}index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1{% endblock %}">

		<meta name="referrer" content="strict-origin-when-cross-origin">

		<meta
		name="theme-color" content="#ffffff">

		{# Évite l’indexation de plusieurs variantes de la même URL. #}
		<link
		rel="canonical" href="{% block url_canonique %}{{ urlCanoniqueParDefaut }}{% endblock %}">

		{# Valeurs réutilisées par les réseaux sociaux et le JSON-LD. #}
		{% set titreSeo = (
            block('title') ~ block('suffixe_titre')
        )|striptags|trim %}

		{% set descriptionSeo = block('description_seo')|striptags|trim %}
		{% set urlSeo = block('url_canonique')|striptags|trim %}

		{# ================= OPEN GRAPH ================= #}
		<meta property="og:type" content="{% block type_open_graph %}website{% endblock %}">

		<meta property="og:locale" content="fr_FR">

		<meta property="og:site_name" content="Webble">

		<meta property="og:title" content="{{ titreSeo|e('html_attr') }}">

		<meta property="og:description" content="{{ descriptionSeo|e('html_attr') }}">

		<meta property="og:url" content="{{ urlSeo|e('html_attr') }}">

		<meta property="og:image" content="{% block image_seo %}https://webble.fr/images/webble_black.jpg{% endblock %}">

		<meta property="og:image:alt" content="{% block texte_alternatif_image_seo %}Webble, création de sites internet{% endblock %}">

		{% set imageSeo = block('image_seo')|striptags|trim %}
		{% set texteAlternatifImageSeo = block(
            'texte_alternatif_image_seo'
        )|striptags|trim %}

		{# ================= CARTES SOCIALES ================= #}
		<meta name="twitter:card" content="summary_large_image">

		<meta name="twitter:title" content="{{ titreSeo|e('html_attr') }}">

		<meta name="twitter:description" content="{{ descriptionSeo|e('html_attr') }}">

		<meta name="twitter:image" content="{{ imageSeo|e('html_attr') }}">

		<meta
		name="twitter:image:alt" content="{{ texteAlternatifImageSeo|e('html_attr') }}">

		{# ================= DONNÉES STRUCTURÉES ================= #}
		{% set donneesStructurees = {
            '@context': 'https://schema.org',
            '@graph': [
                {
                    '@type': 'Organization',
                    '@id': 'https://webble.fr/#organization',
                    'name': 'Webble',
                    'url': 'https://webble.fr/',
                    'logo': {
                        '@type': 'ImageObject',
                        'url': 'https://webble.fr/images/webble_black.jpg'
                    }
                },
                {
                    '@type': 'WebSite',
                    '@id': 'https://webble.fr/#website',
                    'url': 'https://webble.fr/',
                    'name': 'Webble',
                    'publisher': {
                        '@id': 'https://webble.fr/#organization'
                    },
                    'inLanguage': 'fr-FR'
                },
                {
                    '@type': 'WebPage',
                    '@id': urlSeo ~ '#webpage',
                    'url': urlSeo,
                    'name': titreSeo,
                    'description': descriptionSeo,
                    'isPartOf': {
                        '@id': 'https://webble.fr/#website'
                    },
                    'about': {
                        '@id': 'https://webble.fr/#organization'
                    },
                    'primaryImageOfPage': {
                        '@type': 'ImageObject',
                        'url': imageSeo
                    },
                    'inLanguage': 'fr-FR'
                }
            ]
        } %}

		<script type="application/ld+json">
			{{ donneesStructurees|json_encode|raw }}
		</script>

		{# ================= ICÔNE ================= #}
		<link
		rel="icon" type="image/x-icon" sizes="any" href="{{ asset('images/favicon.ico') }}">

		{# Prépare la connexion au CDN sans modifier les dépendances. #}
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

		<link
		rel="dns-prefetch" href="//cdn.jsdelivr.net">

		{# ================= BOOTSTRAP ET BIBLIOTHÈQUES ================= #}
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

		<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

		{# ================= STYLES WEBPACK ENCORE ================= #}
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}

		{# Le contenu reste accessible lorsque JavaScript est désactivé. #}
		<noscript>
			<style>
				#site-loader {
					display: none !important;
				}

				body.site-loading {
					overflow: auto !important;
				}
			</style>
		</noscript>
	</head>

	<body
		class="bg-dark site-loading">

		{# ================= LOADER ================= #}
		<div id="site-loader" class="site-loader" role="status" aria-label="Chargement du site">
			<div class="loader-content">
				<img src="{{ asset('images/webble_black.svg') }}" alt="Webble" class="loader-logo-img">

				<div class="loader-bar" aria-hidden="true">
					<span></span>
				</div>
			</div>
		</div>

		{# ================= NAVIGATION ================= #}
		{% include 'menu/menu.html.twig' %}

		{# ================= CONTENU DE LA PAGE ================= #}
		{% block body %}{% endblock %}

		{# ================= JAVASCRIPT WEBPACK ENCORE ================= #}
		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</body>
</html>
