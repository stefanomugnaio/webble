{# templates/menu/navbar.html.twig #}

<nav class="navbar navbar-dark position-absolute top-0 start-0 w-100 z-3 mb-5 mb-md-0 navbar-mobile-margin">

    {# Pleine largeur sur écrans de portable / desktop standards #}
    <div class="container-fluid py-3 d-flex d-xxl-none">

        {# Logo + nom de l'agence #}
        <a class="navbar-brand d-flex align-items-center" href="{{ path('app_index') }}">
            <div class="d-inline-flex align-items-center justify-content-center">
                <img src="{{ asset('images/webble_black.svg') }}" alt="Logo Webble" width="200">
            </div>
        </a>

        {# Bouton MENU qui ouvre l’offcanvas #}
        <button class="navbar-toggler border-0 shadow-none ms-auto p-0"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#mainMenu"
                aria-controls="mainMenu"
                aria-label="Ouvrir le menu">
            <i class="bi bi-list fs-2 text-dark"></i>
        </button>

    </div>

    {# Rendu centré comme avant sur très grands écrans #}
    <div class="container py-3 d-none d-xxl-flex">

        {# Logo + nom de l'agence #}
        <a class="navbar-brand d-flex align-items-center" href="{{ path('app_index') }}">
            <div class="d-inline-flex align-items-center justify-content-center">
                <img src="{{ asset('images/webble_black.svg') }}" alt="Logo Webble" width="200">
            </div>
        </a>

        {# Bouton MENU qui ouvre l’offcanvas #}
        <button class="navbar-toggler border-0 shadow-none ms-auto p-0"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#mainMenu"
                aria-controls="mainMenu"
                aria-label="Ouvrir le menu">
            <i class="bi bi-list fs-2 text-dark"></i>
        </button>

    </div>
</nav>

{# Menu offcanvas (latéral) #}
<div class="offcanvas offcanvas-end bg-dark"
     style="color: #EEEEEE"
     tabindex="-1"
     id="mainMenu"
     aria-labelledby="mainMenuLabel">

    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="mainMenuLabel"></h5>
        <button type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="offcanvas"
                aria-label="Fermer"></button>
    </div>

    <div class="offcanvas-body d-flex flex-column">

        <ul class="nav flex-column mb-4">
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ path('app_index') }}">Accueil</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ path('app_creation_site') }}">Création de site web</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ path('app_liste_formations') }}">Formations</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ path('app_contact') }}">Contact</a>
            </li>
            <li class="nav-item mb-2">
                {% if app.user %}
                    <a class="nav-link text-white" href="{{ path('app_profil') }}">Espace client</a>
                {% else %}
                    <a class="nav-link text-white" href="{{ path('app_connexion') }}">Espace client</a>
                {% endif %}
            </li>
            {% if app.user %}
            <li class="nav-item mb-2">
                <a class="nav-link text-white" href="{{ path('app_logout') }}">Déconnexion</a>
            </li>
            {% endif %}
        </ul>

        {# --- Bas du menu : liens légaux --- #}
        <div class="mt-auto pt-3 border-top border-secondary">

            <a class="nav-link text-secondary small" href="{{ path('app_mentions_legales') }}">
                Mentions légales
            </a>

            <a class="nav-link text-secondary small mt-1" href="{{ path('app_cgv') }}">
                Conditions générales de vente (CGV)
            </a>

        </div>

    </div>
</div>