{% extends 'base.html.twig' %}

{% block title %}Planning des formations{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container py-5">

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0">
                        <i class="bi bi-calendar-event me-2"></i>
                        Planning des formations
                    </h4>
                </div>

                {# CALENDRIER #}
                <div id="calendar"
                     data-events-url="{{ path('planning_formations_evenements') }}">
                </div>

                {# LEGENDE #}
                <div class="mt-4 d-flex flex-wrap gap-4 align-items-center">
                    <div class="d-flex align-items-center">
                        <span style="display:inline-block; width:16px; height:16px; min-width:16px; border-radius:4px; background:blue; margin-right:8px;"></span>
                        <span>Disponible</span>
                    </div>

                    <div class="d-flex align-items-center">
                        <span style="display:inline-block; width:16px; height:16px; min-width:16px; border-radius:4px; background:#ffc107; margin-right:8px;"></span>
                        <span>Complet</span>
                    </div>

                    <div class="d-flex align-items-center">
                        <span style="display:inline-block; width:16px; height:16px; min-width:16px; border-radius:4px; background:#dc3545; margin-right:8px;"></span>
                        <span>Annulée</span>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('planning') }}
{% endblock %}