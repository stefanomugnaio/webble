{% extends 'base.html.twig' %}

{% block title %}Planning des formations{% endblock %}

{% block body %}
<section class="py-5 min-vh-100 margin-top-responsive" style="background: #f8f9fa;">
    <div class="container py-4 py-lg-5">

        <div class="text-center mx-auto mb-5" style="max-width: 760px;">
            <p class="text-uppercase small fw-semibold text-secondary mb-2" style="letter-spacing: .08em;">
                Calendrier
            </p>
            <h1 class="fw-semibold text-dark mb-3">
                Planning des formations
            </h1>
            <p class="text-secondary mb-0">
                Consultez les prochaines sessions disponibles et choisissez la période qui vous convient.
            </p>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-lg-5">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="h5 fw-semibold text-dark mb-0">
                        <i class="bi bi-calendar-event me-2"></i>
                        Sessions de formation
                    </h2>
                </div>

                {# CALENDRIER #}
                <div id="calendar"
                     data-events-url="{{ path('planning_formations_evenements') }}">
                </div>

                {# LEGENDE #}
                <div class="mt-4 d-flex flex-wrap gap-3 gap-md-4 align-items-center">

                    <div class="d-flex align-items-center border rounded-pill bg-light px-3 py-2">
                        <span style="display:inline-block; width:14px; height:14px; min-width:14px; border-radius:999px; background:#0d6efd; margin-right:8px;"></span>
                        <span class="small text-dark">Disponible</span>
                    </div>

                    <div class="d-flex align-items-center border rounded-pill bg-light px-3 py-2">
                        <span style="display:inline-block; width:14px; height:14px; min-width:14px; border-radius:999px; background:#ffc107; margin-right:8px;"></span>
                        <span class="small text-dark">Complet</span>
                    </div>

                    <div class="d-flex align-items-center border rounded-pill bg-light px-3 py-2">
                        <span style="display:inline-block; width:14px; height:14px; min-width:14px; border-radius:999px; background:#dc3545; margin-right:8px;"></span>
                        <span class="small text-dark">Annulée</span>
                    </div>

                </div>

            </div>
        </div>

    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('planning') }}
{% endblock %}