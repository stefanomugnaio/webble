{% extends 'base.html.twig' %}

{% block title %}Ajouter un document{% endblock %}

{% block body %}
    <main class="container py-5">
        <div class="mx-auto" style="max-width: 680px;">
            <h1 class="h2 mb-3">Ajouter un document</h1>
            <p class="text-muted mb-4">Sélectionnez un document PDF à conserver dans votre espace client.</p>

            {{ form_start(form) }}
                {{ form_row(form.fichier, {
                    label: 'Document PDF',
                    attr: {class: 'form-control', accept: 'application/pdf'}
                }) }}
                <button class="btn btn-primary mt-3" type="submit">Ajouter le document</button>
            {{ form_end(form) }}
        </div>
    </main>
{% endblock %}
