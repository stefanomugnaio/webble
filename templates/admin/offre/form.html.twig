{% extends 'admin/layout.html.twig' %}
{% block admin_title %}{{ is_new ? 'Créer une offre' : 'Modifier l’offre' }}{% endblock %}
{% block admin_heading %}{{ is_new ? 'Créer une offre' : 'Modifier l’offre ' ~ offre.numero }}{% endblock %}
{% block admin_description %}Ajoutez des tâches de la bibliothèque, puis adaptez librement chaque ligne à cette offre.{% endblock %}
{% block admin_content %}
{{ form_start(form, {attr: {id: 'offre-form'}}) }}{{ form_errors(form) }}
<div class="row g-4">
<div class="col-12"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-lg-5"><h2 class="h5 mb-4">Informations générales</h2><div class="row g-3"><div class="col-md-6">{{ form_row(form.numero) }}</div><div class="col-md-6">{{ form_row(form.statut) }}</div><div class="col-md-6">{{ form_row(form.dateEmission) }}</div><div class="col-md-6">{{ form_row(form.dateValidite) }}</div><div class="col-12">{{ form_row(form.objet) }}</div><div class="col-12">{{ form_row(form.introduction) }}</div></div></div></div></div>
<div class="col-12"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-lg-5"><h2 class="h5 mb-4">Destinataire</h2><div class="row g-3"><div class="col-md-6">{{ form_row(form.clientNom) }}</div><div class="col-md-6">{{ form_row(form.clientSociete) }}</div><div class="col-md-6">{{ form_row(form.clientEmail) }}</div><div class="col-md-6">{{ form_row(form.clientAdresse) }}</div></div></div></div></div>
<div class="col-12"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-lg-5">
<div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4"><div><h2 class="h5 mb-1">Lignes de détail</h2><p class="text-secondary mb-0">Les données importées restent entièrement modifiables dans cette offre.</p></div><div class="d-flex flex-column flex-sm-row gap-2"><select id="task-library" class="form-select" aria-label="Choisir une tâche"><option value="">Choisir dans la bibliothèque…</option>{% for tache in taches %}<option value="{{ tache.id }}" data-label="{{ tache.libelle|e('html_attr') }}" data-quantity="{{ tache.quantite }}" data-price="{{ tache.prixUnitaire }}" data-free="{{ tache.offerte ? '1' : '0' }}">{{ tache.libelle }} — {{ tache.offerte ? 'Offerte' : tache.prixUnitaire|number_format(2, ',', ' ') ~ ' €' }}</option>{% endfor %}</select><button type="button" id="add-task-line" class="btn btn-primary text-nowrap"><i class="bi bi-plus-lg me-2"></i>Ajouter</button><button type="button" id="add-empty-line" class="btn btn-outline-secondary text-nowrap">Ligne vide</button></div></div>
{{ form_errors(form.lignes) }}
<div id="offer-lines" data-prototype="{{ form_widget(form.lignes.vars.prototype)|e('html_attr') }}" data-index="{{ form.lignes|length }}">
{% for ligne in form.lignes %}<div class="offer-line" data-offer-line><div class="offer-line__head"><span class="offer-line__number">Ligne {{ loop.index }}</span><button type="button" class="btn btn-sm btn-outline-danger" data-remove-line><i class="bi bi-trash me-1"></i>Retirer</button></div><div class="row g-3"><div class="col-lg-6">{{ form_row(ligne.libelle) }}</div><div class="col-sm-4 col-lg-2">{{ form_row(ligne.quantite) }}</div><div class="col-sm-4 col-lg-2">{{ form_row(ligne.prixUnitaire) }}</div><div class="col-sm-4 col-lg-2 d-flex align-items-end pb-3">{{ form_row(ligne.offerte) }}</div></div>{{ form_widget(ligne.position) }}<div class="offer-line__total">Total de la ligne : <strong data-line-total>0,00 €</strong></div></div>{% endfor %}
</div><div id="offer-lines-empty" class="admin-empty-state py-4 {{ form.lignes|length ? 'd-none' : '' }}"><i class="bi bi-list-ul"></i><p class="mb-0">Ajoutez une tâche de la bibliothèque ou une ligne vide.</p></div>
</div></div></div>
<div class="col-lg-7"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4 p-lg-5"><h2 class="h5 mb-4">Conditions</h2>{{ form_row(form.conditions) }}<div class="row"><div class="col-sm-6">{{ form_row(form.tauxTva) }}</div></div>{% if offre.papierEnteteUrl %}<div class="alert alert-light border mt-3 mb-0"><i class="bi bi-file-earmark-image me-2"></i>Le papier à en-tête configuré sera utilisé dans le PDF.</div>{% else %}<div class="alert alert-warning mt-3 mb-0">Aucun papier à en-tête n’est associé. Vous pouvez en définir un dans les paramètres.</div>{% endif %}</div></div></div>
<div class="col-lg-5"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body p-4 p-lg-5"><h2 class="h5 mb-4">Récapitulatif</h2><div class="offer-summary"><div><span>Total HT</span><strong id="offer-total-ht">0,00 €</strong></div><div><span>TVA</span><strong id="offer-total-vat">0,00 €</strong></div><div class="offer-summary__total"><span>Total TTC</span><strong id="offer-total-ttc">0,00 €</strong></div></div></div></div></div>
</div>
<div class="d-flex flex-column flex-sm-row justify-content-between gap-3 mt-4"><a href="{{ path('admin_offre_index') }}" class="btn btn-outline-secondary rounded-pill px-4">Annuler</a><button class="btn btn-primary rounded-pill px-5">{{ is_new ? 'Créer l’offre' : 'Enregistrer les modifications' }}</button></div>
{{ form_widget(form._token) }}{{ form_end(form, {render_rest: false}) }}
{% endblock %}
