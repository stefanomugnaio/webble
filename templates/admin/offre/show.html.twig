{% extends 'admin/layout.html.twig' %}
{% block admin_title %}{{ offre.numero }}{% endblock %}
{% block admin_heading %}Offre {{ offre.numero }}{% endblock %}
{% block admin_description %}{{ offre.objet }}{% endblock %}
{% block admin_content %}
<div class="d-flex flex-wrap gap-2 mb-4"><a href="{{ path('admin_offre_pdf', {id: offre.id}) }}" class="btn btn-dark rounded-pill px-4" download><i class="bi bi-file-earmark-pdf me-2"></i>Télécharger le PDF</a><a href="{{ path('admin_offre_edit', {id: offre.id}) }}" class="btn btn-outline-primary rounded-pill px-4"><i class="bi bi-pencil me-2"></i>Modifier</a><form method="post" action="{{ path('admin_offre_duplicate', {id: offre.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('duplicate_offre' ~ offre.id) }}"><button class="btn btn-outline-secondary rounded-pill px-4"><i class="bi bi-copy me-2"></i>Dupliquer</button></form></div>
<div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-lg-5"><div class="d-flex justify-content-between gap-3 mb-4"><div><span class="badge rounded-pill offre-status offre-status--{{ offre.statut }}">{{ offre.statut|capitalize }}</span><h2 class="h4 mt-3 mb-1">{{ offre.objet }}</h2><p class="text-secondary mb-0">Émise le {{ offre.dateEmission|date('d/m/Y') }} · valide jusqu’au {{ offre.dateValidite|date('d/m/Y') }}</p></div></div>{% if offre.introduction %}<p class="mb-4">{{ offre.introduction|nl2br }}</p>{% endif %}<div class="table-responsive"><table class="table align-middle"><thead class="table-light"><tr><th>Détail</th><th class="text-end">Qté</th><th class="text-end">PU HT</th><th class="text-end">Total HT</th></tr></thead><tbody>{% for ligne in offre.lignes %}<tr><td>{{ ligne.libelle|nl2br }}{% if ligne.offerte %}<span class="badge text-bg-success ms-2">Offerte</span>{% endif %}</td><td class="text-end">{{ ligne.quantite|number_format(2, ',', ' ') }}</td><td class="text-end">{{ ligne.prixUnitaire|number_format(2, ',', ' ') }} €</td><td class="text-end fw-semibold">{{ ligne.offerte ? 'Offert' : ligne.totalHt|number_format(2, ',', ' ') ~ ' €' }}</td></tr>{% endfor %}</tbody></table></div>{% if offre.conditions %}<div class="mt-4 pt-3 border-top"><h3 class="h6">Conditions et précisions</h3><p class="text-secondary mb-0">{{ offre.conditions|nl2br }}</p></div>{% endif %}</div></div></div>
<div class="col-lg-4"><div class="card border-0 shadow-sm rounded-4 mb-4"><div class="card-body p-4"><h2 class="h6">Destinataire</h2><p class="fw-semibold mb-1">{{ offre.clientNom }}</p>{% if offre.clientSociete %}<p class="mb-1">{{ offre.clientSociete }}</p>{% endif %}{% if offre.clientEmail %}<p class="mb-1"><a href="mailto:{{ offre.clientEmail }}">{{ offre.clientEmail }}</a></p>{% endif %}{% if offre.clientAdresse %}<p class="text-secondary mb-0">{{ offre.clientAdresse|nl2br }}</p>{% endif %}</div></div><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4"><div class="offer-summary"><div><span>Total HT</span><strong>{{ offre.totalHt|number_format(2, ',', ' ') }} €</strong></div><div><span>TVA ({{ offre.tauxTva|number_format(2, ',', ' ') }} %)</span><strong>{{ offre.montantTva|number_format(2, ',', ' ') }} €</strong></div><div class="offer-summary__total"><span>Total TTC</span><strong>{{ offre.totalTtc|number_format(2, ',', ' ') }} €</strong></div></div></div></div></div></div>
<form method="post" action="{{ path('admin_offre_delete', {id: offre.id}) }}" class="mt-4" onsubmit="return confirm('Supprimer définitivement cette offre ?');"><input type="hidden" name="_token" value="{{ csrf_token('delete_offre' ~ offre.id) }}"><button class="btn btn-link text-danger px-0"><i class="bi bi-trash me-2"></i>Supprimer cette offre</button></form>
{% endblock %}
