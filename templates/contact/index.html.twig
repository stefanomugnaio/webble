{# templates/contact/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('contact') }}
{% endblock %}

{% block body %}
<section class="min-vh-100 py-5" style="background: #f8f9fa;">
    <div class="container margin-top-responsive py-4 py-lg-5">

        <div class="text-center mx-auto mb-5" style="max-width: 760px;">
            <p class="text-uppercase small fw-semibold text-secondary mb-2" style="letter-spacing: .08em;">
                Contact
            </p>
            <h1 class="fw-semibold text-dark mb-3">
                Parlons de votre projet.
            </h1>
            <p class="text-secondary mb-0">
                Une question, une idée de site web, un besoin de formation ?
                Dites-moi où vous en êtes, je vous réponds rapidement avec des pistes concrètes.
            </p>
        </div>

        <div class="row g-4 align-items-start justify-content-center">

            {# Colonne gauche : infos #}
            <div class="col-12 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 p-lg-5">

                        <span class="badge rounded-pill bg-dark text-white px-3 py-2 small fw-medium mb-4">
                            Contact direct
                        </span>

                        <h2 class="h4 fw-semibold text-dark mb-3">
                            Un échange simple et rapide
                        </h2>

                        <p class="text-secondary mb-4">
                            Que ce soit pour un site vitrine, une refonte, une demande de devis
                            ou une formation, vous pouvez utiliser ce formulaire pour expliquer
                            votre besoin de manière simple.
                        </p>

                        <div class="border rounded-4 bg-light p-3 mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-envelope text-secondary me-2"></i>
                                <span class="small fw-medium text-dark">E-mail</span>
                            </div>
                            <div class="text-secondary">
                                contact@webble.fr
                            </div>
                        </div>

                        <div class="border rounded-4 bg-light p-3 mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-chat-dots text-secondary me-2"></i>
                                <span class="small fw-medium text-dark">Réponse</span>
                            </div>
                            <div class="text-secondary small">
                                Je reviens vers vous dès que possible pour clarifier votre besoin.
                            </div>
                        </div>

                        <div class="border rounded-4 bg-light p-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-check-circle text-secondary me-2"></i>
                                <span class="small fw-medium text-dark">Approche</span>
                            </div>
                            <div class="text-secondary small">
                                Réponse claire, concrète, sans blabla commercial.
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            {# Colonne droite : formulaire #}
            <div class="col-12 col-xl-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-md-5">

                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ label }} rounded-4 flash-message mb-4" role="alert">
                                    {{ message }}
                                </div>
                            {% endfor %}
                        {% endfor %}

                        <div class="mb-4">
                            <h2 class="h4 fw-semibold text-dark mb-2">
                                Envoyer un message
                            </h2>
                            <p class="text-secondary mb-0">
                                Remplissez ce formulaire, je reviens vers vous dès que possible
                                pour voir comment je peux vous aider.
                            </p>
                        </div>

                        {{ form_start(form, {
                            attr: {
                                id: 'contact-form',
                                'data-recaptcha-site-key': recaptcha_site_key
                            }
                        }) }}

                            <div class="row g-3">

                                <div class="col-12 col-md-6">
                                    {{ form_label(form.nom, 'Nom', {'label_attr': {'class': 'form-label text-dark fw-medium'}}) }}
                                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger small mt-1 error-message">
                                        {{ form_errors(form.nom) }}
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_label(form.prenom, 'Prénom', {'label_attr': {'class': 'form-label text-dark fw-medium'}}) }}
                                    {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger small mt-1 error-message">
                                        {{ form_errors(form.prenom) }}
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label text-dark fw-medium'}}) }}
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'vous@example.com'}}) }}
                                    <div class="text-danger small mt-1 error-message">
                                        {{ form_errors(form.email) }}
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_label(form.sujet, 'Sujet', {'label_attr': {'class': 'form-label text-dark fw-medium'}}) }}
                                    {{ form_widget(form.sujet, {
                                        'attr': {
                                            'class': 'form-select'
                                        }
                                    }) }}
                                    <div class="text-danger small mt-1 error-message">
                                        {{ form_errors(form.sujet) }}
                                    </div>
                                </div>

                                {# ====== Numéro de contrat ====== #}
                                <div id="num-contrat-wrapper" class="col-12 d-none">
                                    {{ form_label(form.num_contrat, 'Numéro de contrat', {'label_attr': {'class': 'form-label text-dark fw-medium'}}) }}
                                    {{ form_widget(form.num_contrat, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger small mt-1 error-message">
                                        {{ form_errors(form.num_contrat) }}
                                    </div>
                                </div>

                                <div class="col-12">
                                    {{ form_label(form.description, 'Parlez moi de votre besoin...', {'label_attr': {'class': 'form-label text-dark fw-medium'}}) }}
                                    {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger small mt-1 error-message">
                                        {{ form_errors(form.description) }}
                                    </div>
                                </div>

                                <div class="col-12 mt-3">
                                    {{ form_widget(form.recaptchaToken) }}
                                </div>

                                {# Champ date_creation caché #}
                                <div class="d-none">
                                    {{ form_widget(form.date_creation) }}
                                </div>

                                <div class="col-12 mt-2">
                                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
                                        <i class="bi bi-send me-2"></i>
                                        Envoyer mon message
                                    </button>
                                </div>

                            </div>

                        {{ form_end(form) }}

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://www.google.com/recaptcha/api.js?render={{ recaptcha_site_key }}"></script>
    {{ encore_entry_script_tags('contact') }}
{% endblock %}