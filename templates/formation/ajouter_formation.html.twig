{% extends 'base.html.twig' %}

{% block title %}Ajouter une formation{% endblock %}

{% block body %}
<section class="py-5 margin-top-responsive" style="min-height: 100vh;">
    <div class="container" style="max-width: 800px;">

        <div class="text-center mb-5">
            <p class="text-uppercase small text-muted mb-1">
                Administration
            </p>
            <h1 class="fw-bold">
                Ajouter une formation
            </h1>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">

                {{ form_start(form, {
                    attr: {
                        novalidate: 'novalidate'
                    }
                }) }}

                {# Erreurs globales #}
                {{ form_errors(form) }}

                <div class="mb-3">
                    {{ form_label(form.libelle) }}
                    {{ form_widget(form.libelle) }}
                    {{ form_errors(form.libelle) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.prix) }}
                    <div class="input-group">
                        {{ form_widget(form.prix) }}
                        <span class="input-group-text">€</span>
                    </div>
                    {{ form_errors(form.prix) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.duree) }}
                    <div class="input-group">
                        {{ form_widget(form.duree) }}
                        <span class="input-group-text">heures</span>
                    </div>
                    {{ form_errors(form.duree) }}
                </div>

                <div class="d-flex justify-content-between mt-4">

                    <a href="{{ path('app_liste_formations') }}"
                       class="btn btn-outline-secondary rounded-pill">
                        Retour
                    </a>

                    <button type="submit"
                            class="btn btn-primary rounded-pill px-4">
                        Enregistrer la formation
                    </button>

                </div>

                {{ form_end(form) }}

            </div>
        </div>

    </div>
</section>
{% endblock %}