{% extends 'base.html.twig' %}

{% block title %}Créer une session de formation{% endblock %}

{% block body %}
<section class="py-5 min-vh-100 margin-top-responsive" style="background: #f8f9fa;">
    <div class="container py-4 py-lg-5" style="max-width: 720px;">

        <div class="text-center mx-auto mb-5" style="max-width: 640px;">
            <p class="text-uppercase small fw-semibold text-secondary mb-2" style="letter-spacing: .08em;">
                Administration
            </p>
            <h1 class="fw-semibold text-dark mb-3">
                Créer une session de formation
            </h1>
            <p class="text-secondary mb-0">
                Renseignez les informations nécessaires pour ajouter une nouvelle session au planning.
            </p>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-lg-5">

                {{ form_start(form) }}

                <div class="mb-4">
                    {{ form_label(form.date_debut, null, { label_attr: { class: 'form-label text-dark fw-medium' } }) }}
                    {{ form_widget(form.date_debut, {'attr': {'class': 'form-control'}}) }}
                    <div class="error-message">
                        {{ form_errors(form.date_debut) }}
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.date_fin, null, { label_attr: { class: 'form-label text-dark fw-medium' } }) }}
                    {{ form_widget(form.date_fin, {'attr': {'class': 'form-control'}}) }}
                    <div class="error-message">
                        {{ form_errors(form.date_fin) }}
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.status, null, { label_attr: { class: 'form-label text-dark fw-medium' } }) }}
                    {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
                    <div class="error-message">
                        {{ form_errors(form.status) }}
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.formation, null, { label_attr: { class: 'form-label text-dark fw-medium' } }) }}
                    {{ form_widget(form.formation, {'attr': {'class': 'form-control'}}) }}
                    <div class="error-message">
                        {{ form_errors(form.formation) }}
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 mt-4">
                    <a href="{{ path('app_profil') }}" class="btn btn-outline-secondary rounded-pill px-4">
                        Retour
                    </a>

                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        Créer la session
                    </button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>

    </div>
</section>
{% endblock %}