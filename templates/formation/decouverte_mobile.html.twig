{% extends 'base.html.twig' %}

{% block title %}Formation – Découverte mobile{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('creation_site') }}
{% endblock %}

{% block body %}
<section class="py-5 min-vh-100 margin-top-responsive" style="background: #f8f9fa;">
    <div class="container py-4 py-lg-5">

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-4 p-lg-5">

                {# ================= HEADER ================= #}
                <div class="row align-items-center g-5 mb-5">

                    {# TEXTE GAUCHE #}
                    <div class="col-lg-6">

                        <p class="text-uppercase small fw-semibold text-secondary mb-2" style="letter-spacing: .08em;">
                            Formation
                        </p>

                        <h1 class="fw-semibold text-dark mb-3">
                            Découverte mobile
                        </h1>

                        <p class="fs-5 text-secondary mb-4">
                            Maîtrisez les bases du smartphone pour communiquer, naviguer sur Internet
                            et utiliser les applications du quotidien.
                        </p>

                        <div class="border rounded-4 bg-light p-3 p-md-4 mb-4">
                            <div class="row g-3 small text-secondary">

                                <div class="col-md-4 d-flex align-items-center">
                                    <i class="bi bi-calendar-event me-2"></i>
                                    Formation ponctuelle
                                </div>

                                <div class="col-md-4 d-flex align-items-center">
                                    <i class="bi bi-clock-history me-2"></i>
                                    Durée : 4 heures
                                </div>

                                <div class="col-md-4 d-flex align-items-center">
                                    <i class="bi bi-house-door me-2"></i>
                                    À domicile
                                </div>

                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-3">
                            <a href="{{ path('app_formation', { formation: 'decouverte-mobile' }) }}"
                               class="btn btn-primary rounded-pill px-4">
                                Démarrer mon inscription
                            </a>

                            <a href="{{ path('app_planning') }}"
                               class="btn btn-outline-secondary rounded-pill px-4">
                                Planning
                            </a>

                            <a href="{{ asset('Documents/Formation - Découverte mobile.pdf') }}"
                               class="btn btn-link text-decoration-none px-0"
                               download>
                                Télécharger le programme
                            </a>
                        </div>

                    </div>

                    {# IMAGE DROITE #}
                    <div class="col-lg-6 text-center">
                        <div class="border rounded-4 bg-light p-3">
                            <img
                                src="{{ asset('images/mobile.png') }}"
                                alt="Découverte mobile"
                                class="img-fluid rounded-4"
                            >
                        </div>
                    </div>

                </div>

                {# ================= AVANTAGES ================= #}
                <div class="row g-4 mb-5">

                    <div class="col-md-6">
                        <div class="border rounded-4 bg-light p-4 h-100 d-flex gap-3">
                            <i class="bi bi-wifi fs-2 text-primary"></i>
                            <div>
                                <h5 class="fw-semibold text-dark mb-2">
                                    Une formation accessible
                                </h5>
                                <p class="text-secondary mb-0">
                                    Formation adaptée aux débutants, sans prérequis, pour apprendre
                                    à utiliser un smartphone simplement et en toute autonomie.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-4 bg-light p-4 h-100 d-flex gap-3">
                            <i class="bi bi-person-check fs-2 text-primary"></i>
                            <div>
                                <h5 class="fw-semibold text-dark mb-2">
                                    Un accompagnement personnalisé
                                </h5>
                                <p class="text-secondary mb-0">
                                    Formation individuelle ou en petit groupe pour pratiquer directement
                                    sur son téléphone.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

                {# ================= PROGRAMME ================= #}
                <div class="row g-4 align-items-start">
                    <div class="col-lg-8">

                        <h2 class="fw-semibold text-dark mb-3">
                            Programme de la formation
                        </h2>

                        <p class="text-secondary mb-4">
                            Cette formation vous permet d’acquérir les bases essentielles
                            pour utiliser un smartphone et les applications du quotidien en toute autonomie.
                        </p>

                        <div class="border rounded-4 bg-light p-4">
                            <ul class="list-unstyled text-secondary mb-0">
                                <li class="d-flex mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                    <span>Découverte du smartphone (écran tactile, boutons, gestes de base)</span>
                                </li>
                                <li class="d-flex mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                    <span>Comprendre l’interface du téléphone (écran d’accueil, applications, paramètres)</span>
                                </li>
                                <li class="d-flex mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                    <span>Passer des appels et envoyer des SMS</span>
                                </li>
                                <li class="d-flex mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                    <span>Se connecter au Wi-Fi et naviguer sur Internet</span>
                                </li>
                                <li class="d-flex mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                    <span>Télécharger et utiliser des applications utiles du quotidien</span>
                                </li>
                                <li class="d-flex">
                                    <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                    <span>Bonnes pratiques de sécurité mobile</span>
                                </li>
                            </ul>
                        </div>

                    </div>

                    <div class="col-lg-4">
                        <div class="border rounded-4 bg-light p-4">
                            <span class="badge rounded-pill bg-dark text-white px-3 py-2 small fw-medium mb-3">
                                En bref
                            </span>

                            <div class="small text-secondary">
                                <div class="mb-2">
                                    <strong class="text-dark">Niveau :</strong> Débutant
                                </div>
                                <div class="mb-2">
                                    <strong class="text-dark">Durée :</strong> 4 heures
                                </div>
                                <div class="mb-2">
                                    <strong class="text-dark">Format :</strong> Ponctuel
                                </div>
                                <div>
                                    <strong class="text-dark">Lieu :</strong> À domicile
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ================= ACTIONS ================= #}
                <div class="d-flex flex-column gap-3 flex-md-row justify-content-between mt-5">

                    <a href="{{ path('app_liste_formations') }}" class="btn btn-outline-secondary rounded-pill px-4">
                        Retour aux formations
                    </a>

                    <a href="{{ path('app_contact') }}" class="btn btn-primary rounded-pill px-4">
                        Demander des informations
                    </a>

                </div>

            </div>
        </div>

    </div>
</section>
{% endblock %}