{% extends 'base.html.twig' %}

{% block title %}Formation – Découverte mobile{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('creation_site') }}
{% endblock %}

{% block body %}
<section class="py-5 margin-top-responsive mt-5">
    <div class="container mt-5 p-5 bg-white rounded">

        {# ================= HEADER ================= #}
        <div class="row align-items-center mb-5">

            {# TEXTE GAUCHE #}
            <div class="col-lg-6">

                <h1 class="fw-bold mb-3">
                    Découverte mobile
                </h1>

                <p class="fs-5 text-muted mb-4">
                    Maîtrisez les bases du smartphone pour communiquer, naviguer sur Internet et utiliser les applications du quotidien.
                </p>

                <div class="bg-light rounded p-3 mb-4">
                    <div class="row g-3 small text-muted">

                        <div class="col-md-4 d-flex align-items-center">
                            <i class="bi bi-calendar-event me-2"></i>
                            Formation ponctuelle
                        </div>

                        <div class="col-md-4 d-flex align-items-center">
                            <i class="bi bi-clock-history me-2"></i>
                            Durée : 4 heures
                        </div>

                        <div class="col-md-4 d-flex align-items-center">
                            <i class="bi bi-house-door me-2"></i>
                            À domicile
                        </div>

                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3">
                    <a href="{{ path('app_formation', { formation: 'decouverte-mobile' }) }}" 
                    class="btn btn-primary rounded-pill px-4">
                        Démarrer mon inscription
                    </a>
                    <a href="{{ path('app_planning') }}" 
                    class="btn btn-primary rounded-pill px-4">
                        Planning
                    </a>
                    <a
                        href="{{ asset('Documents/Formation - Découverte mobile.pdf') }}"
                        class="btn btn-link text-decoration-none"
                        download
                    >
                        Télécharger le programme
                    </a>
                </div>

            </div>

            {# IMAGE DROITE #}
            <div class="col-lg-6 text-center mt-5 mt-lg-0 rounded">
                <img
                    src="{{ asset('images/mobile.png') }}"
                    alt="Découverte informatique"
                    class="img-fluid rounded"
                >
            </div>

        </div>

        <hr class="my-5">

        {# ================= AVANTAGES ================= #}
        <div class="row g-4 mb-5">

            <div class="col-md-6 d-flex gap-3">
                <i class="bi bi-wifi fs-2 text-primary"></i>
                <div>
                    <h5 class="fw-semibold">
                        Une formation accessible
                    </h5>
                    <p class="text-muted mb-1">
                        Formation adaptée aux débutants, sans prérequis, pour apprendre à utiliser un smartphone simplement et en toute autonomie.
                    </p>
                </div>
            </div>

            <div class="col-md-6 d-flex gap-3">
                <i class="bi bi-person-check fs-2 text-primary"></i>
                <div>
                    <h5 class="fw-semibold">
                        Un accompagnement personnalisé
                    </h5>
                    <p class="text-muted mb-1">
                        Formation individuelle ou en petit groupe pour pratiquer directement sur son téléphone.
                    </p>
                </div>
            </div>

        </div>

        <hr class="my-5">

        {# ================= PROGRAMME ================= #}
        <div class="row">
    <div class="col-lg-8">

        <h2 class="fw-bold mb-4">
            Programme de la formation
        </h2>

        <p class="text-muted mb-4">
            Cette formation vous permet d’acquérir les bases essentielles
            pour utiliser un ordinateur et Internet en toute autonomie.
        </p>

        <ul class="list-unstyled text-muted">
                <div class="row">
                <div class="col-lg-8">

                    <h2 class="fw-bold mb-4">
                        Programme de la formation
                    </h2>

                    <p class="text-muted mb-4">
                        Cette formation vous permet d’acquérir les bases essentielles
                        pour utiliser un smartphone et les applications du quotidien en toute autonomie.
                    </p>

                    <ul class="list-unstyled text-muted">
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Découverte du smartphone (écran tactile, boutons, gestes de base)
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Comprendre l’interface du téléphone (écran d’accueil, applications, paramètres)
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Passer des appels et envoyer des SMS
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Se connecter au Wi-Fi et naviguer sur Internet
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Télécharger et utiliser des applications utiles du quotidien
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Bonnes pratiques de sécurité mobile
                        </li>
                    </ul>

                </div>
            </div>

        {# ================= ACTIONS ================= #}
        <div class="d-flex flex-column gap-3 flex-md-row justify-content-between mt-5">

            <a href="{{ path('app_liste_formations') }}" class="btn btn-outline-secondary rounded-pill">
                Retour aux formations
            </a>

            <a href="{{ path('app_contact') }}" class="btn btn-primary rounded-pill px-4">
                Demander des informations
            </a>

        </div>

    </div>
</section>
{% endblock %}
