{% extends 'base.html.twig' %}

{% block title %}Formation – {{ formation.libelle }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('envoi_devis') }}
{% endblock %}

{% block body %}
<section class="py-5 min-vh-100 margin-top-responsive" style="background: #f8f9fa;">
    <div class="container py-4 py-lg-5">

        {# ================= HEADER ================= #}
        <div class="text-center mx-auto mb-5" style="max-width: 760px;">
            <p class="text-uppercase small fw-semibold text-secondary mb-2" style="letter-spacing: .08em;">
                Demande d'inscription
            </p>
            <h1 class="fw-semibold text-dark mb-3">
                {{ formation.libelle }}
            </h1>
            <p class="text-secondary mb-0">
                {{ formation.description }}
            </p>
        </div>

        {{ form_start(form, {
            attr: {
                id: 'formation-form'
            }
        }) }}

        <div class="row g-4 align-items-start">

            {# ================= COLONNE GAUCHE ================= #}
            <div class="col-12 col-xl-7">

                {# ================= COORDONNÉES ================= #}
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 p-lg-5">
                        <h5 class="fw-semibold text-dark mb-4">
                            Vos coordonnées
                        </h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_label(form.nom) }}
                                {{ form_widget(form.nom) }}
                                <div class="error-message">{{ form_errors(form.nom) }}</div>
                            </div>

                            <div class="col-md-6">
                                {{ form_label(form.prenom) }}
                                {{ form_widget(form.prenom) }}
                                <div class="error-message">{{ form_errors(form.prenom) }}</div>
                            </div>

                            <div class="col-md-6">
                                {{ form_label(form.email) }}
                                {{ form_widget(form.email) }}
                                <div class="error-message">{{ form_errors(form.email) }}</div>
                            </div>

                            <div class="col-md-6">
                                {{ form_label(form.telephone) }}
                                {{ form_widget(form.telephone) }}
                                <div class="error-message">{{ form_errors(form.telephone) }}</div>
                            </div>

                            <div class="col-12">
                                {{ form_label(form.adresse) }}
                                {{ form_widget(form.adresse) }}
                                <div class="error-message">{{ form_errors(form.adresse) }}</div>
                            </div>

                            <div class="col-md-6">
                                {{ form_label(form.code_postal) }}
                                {{ form_widget(form.code_postal) }}
                                <div class="error-message">{{ form_errors(form.code_postal) }}</div>
                            </div>

                            <div class="col-md-6">
                                {{ form_label(form.ville) }}
                                {{ form_widget(form.ville) }}
                                <div class="error-message">{{ form_errors(form.ville) }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ================= CHOIX SESSION ================= #}
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 p-lg-5">
                        <h5 class="fw-semibold text-dark mb-4">
                            Choisissez votre session de formation
                        </h5>

                        <div class="col-12">
                            {{ form_label(form.sessionFormation) }}
                            {{ form_widget(form.sessionFormation) }}
                            <div class="error-message">
                                {{ form_errors(form.sessionFormation) }}
                            </div>
                        </div>

                        <div class="border rounded-4 bg-light p-3 mt-4">
                            <p class="small text-secondary mb-0">
                                Pour consulter les horaires et jours précis des formations, consultez le
                                <a href="{{ path('app_planning_formations') }}" class="link-secondary text-decoration-underline">
                                    planning détaillé des formations
                                </a>
                            </p>
                        </div>
                    </div>
                </div>

            </div>

            {# ================= COLONNE DROITE ================= #}
            <div class="col-12 col-xl-5">

                {# ================= DÉTAILS FORMATION ================= #}
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold text-dark mb-4">
                            Détails de la formation
                        </h5>

                        <div class="row mb-2">
                            <div class="col-6 text-secondary small">
                                Durée
                            </div>
                            <div class="col-6 text-end fw-semibold text-dark">
                                {{ formation.duree }} heures
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6 text-secondary small">
                                Prix (HT)
                            </div>
                            <div class="col-6 text-end fw-semibold text-dark">
                                {{ montants.prix_ht|number_format(2, ',', ' ') }} €
                            </div>
                        </div>
                    </div>
                </div>

                {# ================= RÉCAPITULATIF ================= #}
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">

                        <h5 class="fw-semibold text-dark mb-4">
                            Récapitulatif
                        </h5>

                        <script>
                            window.prixFormationHT = {{ montants.prix_ht }};
                            window.tauxTVA = {{ taux_tva }};
                        </script>

                        <div class="row mb-2">
                            <div class="col-6 text-secondary small">
                                Formation (HT)
                            </div>
                            <div class="col-6 text-end fw-semibold text-dark">
                                {{ montants.prix_ht|number_format(2, ',', ' ') }} €
                            </div>
                        </div>

                        <hr>

                        <div class="row mb-2">
                            <div class="col-6 text-secondary small">
                                TVA (0 %)
                            </div>
                            <div class="col-6 text-end fw-semibold text-dark">
                                {{ montants.total_tva|number_format(2, ',', ' ') }} €
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6 fw-semibold text-dark">
                                Total TTC
                            </div>
                            <div class="col-6 text-end fw-bold fs-4 text-dark">
                                {{ montants.total_ttc|number_format(2, ',', ' ') }} €
                            </div>
                        </div>

                    </div>
                </div>

                {# ================= RGPD ================= #}
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="form-check d-flex align-items-start">
                            {{ form_widget(form.rgpd, { attr: { class: 'form-check-input mt-1' } }) }}
                            <label class="form-check-label ms-2 text-dark">
                                J’ai lu et j’accepte la
                                <a href="{{ path('app_politique_confidentialite') }}"
                                   target="_blank"
                                   class="text-decoration-underline">
                                    politique de confidentialité
                                </a>
                                <span class="text-danger">*</span>
                            </label>
                        </div>
                        <div class="error-message">
                            {{ form_errors(form.rgpd) }}
                        </div>
                    </div>
                </div>

                {# ================= ACTIONS ================= #}
                <div class="d-grid gap-3">
                    <a href="{{ path('app_liste_formations') }}"
                       class="btn btn-outline-secondary rounded-pill">
                        Retour aux formations
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4 rounded-pill">
                        Envoyer la demande d'inscription
                    </button>
                </div>

            </div>

        </div>

        {{ form_end(form) }}

    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://www.google.com/recaptcha/api.js?render={{ recaptcha_site_key }}"></script>
    {{ encore_entry_script_tags('devis_formation') }}
{% endblock %}