{% extends 'base.html.twig' %}

{% block title %}Formation – {{ formation.libelle }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('envoi_devis') }}
{% endblock %}

{% block body %}
<section class="py-5 text-white margin-top-responsive" style="min-height: 100vh;">
    <div class="container">

        {# ================= HEADER ================= #}
        <div class="text-center mb-4">
            <p class="text-uppercase small text-white mb-1">Demande d'inscription</p>
            <h1 class="fw-bold">{{ formation.libelle }}</h1>
            <p class="text-white">{{ formation.description }}</p>
        </div>

        {{ form_start(form, {
            attr: {
                id: 'formation-form'
            }
        }) }}

        {# ================= COORDONNÉES ================= #}
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">
                    Dans un premier temps, renseignez vos coordonnées
                </h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom) }}
                        <div class="error-message">{{ form_errors(form.nom) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.prenom) }}
                        {{ form_widget(form.prenom) }}
                        <div class="error-message">{{ form_errors(form.prenom) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.email) }}
                        {{ form_widget(form.email) }}
                        <div class="error-message">{{ form_errors(form.email) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.telephone) }}
                        {{ form_widget(form.telephone) }}
                        <div class="error-message">{{ form_errors(form.telephone) }}</div>
                    </div>
                    <div class="col-12">
                        {{ form_label(form.adresse) }}
                        {{ form_widget(form.adresse) }}
                        <div class="error-message">{{ form_errors(form.adresse) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.code_postal) }}
                        {{ form_widget(form.code_postal) }}
                        <div class="error-message">{{ form_errors(form.code_postal) }}</div>
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.ville) }}
                        {{ form_widget(form.ville) }}
                        <div class="error-message">{{ form_errors(form.ville) }}</div>
                    </div>
                </div>
            </div>
        </div>

        {# ================= CHOIX SESSION ================= #}
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">
                    Choisissez votre session de formation
                </h5>

                <div class="col-12">
                    {{ form_label(form.sessionFormation) }}
                    {{ form_widget(form.sessionFormation) }}
                    <div class="error-message">
                        {{ form_errors(form.sessionFormation) }}
                    </div>
                </div>
            </div>
        </div>

        {# ================= CONTENU FORMATION ================= #}
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">
                    Détails de la formation
                </h5>

                <div class="row mb-2">
                    <div class="col-6 text-muted small">
                        Durée
                    </div>
                    <div class="col-6 text-end fw-semibold">
                        {{ formation.duree }} heures
                    </div>
                </div>

                <div class="row">
                    <div class="col-6 text-muted small">
                        Prix (HT)
                    </div>
                    <div class="col-6 text-end fw-semibold">
                        {{ montants.prix_ht|number_format(2, ',', ' ') }} €
                    </div>
                </div>
            </div>
        </div>

        {# ================= RÉCAPITULATIF ================= #}
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h5 class="fw-semibold mb-3">Récapitulatif</h5>

                <script>
                    window.prixFormationHT = {{ montants.prix_ht }};
                    window.tauxTVA = {{ taux_tva }};
                </script>

                <div class="row mb-2">
                    <div class="col-6 text-muted small">
                        Formation (HT)
                    </div>
                    <div class="col-6 text-end fw-semibold">
                        {{ montants.prix_ht|number_format(2, ',', ' ') }} €
                    </div>
                </div>

                <hr>

                <div class="row mb-2">
                    <div class="col-6 text-muted small">
                        TVA (20 %)
                    </div>
                    <div class="col-6 text-end fw-semibold">
                        {{ montants.total_tva|number_format(2, ',', ' ') }} €
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-6 fw-bold">
                        Total TTC
                    </div>
                    <div class="col-6 text-end fw-bold fs-4">
                        {{ montants.total_ttc|number_format(2, ',', ' ') }} €
                    </div>
                </div>

                {# ================= RGPD ================= #}
                <div class="mt-4 p-3 border rounded bg-white">
                    <div class="form-check d-flex align-items-start">
                        {{ form_widget(form.rgpd, { attr: { class: 'form-check-input mt-1' } }) }}
                        <label class="form-check-label ms-2">
                            J’ai lu et j’accepte la
                            <a href="{{ path('app_politique_confidentialite') }}"
                               target="_blank"
                               class="text-decoration-underline">
                                politique de confidentialité
                            </a>
                            <span class="text-danger">*</span>
                        </label>
                    </div>
                    <div class="error-message">
                        {{ form_errors(form.rgpd) }}
                    </div>
                </div>

                {# ================= ACTIONS ================= #}
                <div class="d-flex flex-column gap-3 flex-md-row justify-content-between mt-4">

                    <a href="{{ path('app_liste_formations') }}"
                       class="btn btn-outline-secondary rounded-pill">
                        Retour aux formations
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4 rounded-pill">
                        Envoyer la demande d'inscription
                    </button>
                </div>

            </div>
        </div>

        {{ form_end(form) }}

    </div>
</section>
{% endblock %}