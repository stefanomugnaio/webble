{% extends 'base.html.twig' %}

{% block title %}Formations{% endblock %}


{% block body %}
<section class="text-white py-5 d-flex align-items-center margin-top-responsive" style="min-height: 100vh;">
    <div class="container py-3">

        <div class="text-center mb-5">
            <p class="text-uppercase fs-4 mb-2">
                Formations
            </p>
            <h1 class="fw-bold mb-2 fs-2 fs-lg-1">
                Apprenez à votre rythme, simplement.
            </h1>
            <p class="text-white fs-6 mb-0">
