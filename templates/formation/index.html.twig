{% extends 'base.html.twig' %}

{% block title %}Formations{% endblock %}

{% block body %}
<section class="py-5 min-vh-100 margin-top-responsive" style="background:#f8f9fa;">
    <div class="container py-4 py-lg-5">

        <div class="text-center mx-auto mb-5" style="max-width:760px;">
            <p class="text-uppercase small fw-semibold text-secondary mb-2" style="letter-spacing:.08em;">
                Formations
            </p>

            <h1 class="fw-semibold text-dark mb-3">
                Apprenez à votre rythme, simplement.
            </h1>

            <p class="text-secondary mb-0">
                Des formations accessibles, pratiques et concrètes.
            </p>
        </div>

        <div class="row g-4 justify-content-center">

            {# Découverte informatique #}
            <div class="col-md-6 col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 text-center">
                    <div class="card-body d-flex flex-column p-4 p-lg-4">

                        <div class="mb-3">
                            <i class="bi bi-laptop fs-1 text-primary"></i>
                        </div>

                        <h5 class="fw-semibold text-dark mb-3">
                            Découverte informatique
                        </h5>

                        <p class="text-secondary small mb-4">
                            Comprendre l'environnement Windows, savoir utiliser un ordinateur,
                            naviguer sur Internet et gérer ses fichiers.
                        </p>

                        <div class="border rounded-4 bg-light p-3 text-start small text-secondary mb-4">

                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-mortarboard me-2"></i>
                                Formation débutant
                            </div>

                            <div class="d-flex align-items-center">
                                <i class="bi bi-calendar-event me-2"></i>
                                Durée : 8H
                            </div>

                        </div>

                        <a href="{{ path('app_decouverte_informatique', {formation: 'decouverte-informatique'}) }}"
                           class="btn btn-primary rounded-pill px-4 mt-auto">
                            Détail de la formation
                        </a>

                    </div>
                </div>
            </div>


            {# Découverte mobile #}
            <div class="col-md-6 col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 text-center">
                    <div class="card-body d-flex flex-column p-4 p-lg-4">

                        <div class="mb-3">
                            <i class="bi bi-phone fs-1 text-primary"></i>
                        </div>

                        <h5 class="fw-semibold text-dark mb-3">
                            Découverte mobile
                        </h5>

                        <p class="text-secondary small mb-4">
                            Maîtrisez les bases du smartphone pour communiquer,
                            naviguer sur Internet et utiliser les applications du quotidien.
                        </p>

                        <div class="border rounded-4 bg-light p-3 text-start small text-secondary mb-4">

                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-mortarboard me-2"></i>
                                Formation débutant
                            </div>

                            <div class="d-flex align-items-center">
                                <i class="bi bi-calendar-event me-2"></i>
                                Durée : 4H
                            </div>

                        </div>

                        <a href="{{ path('app_decouverte_mobile', {formation: 'decouverte-mobile'}) }}"
                           class="btn btn-primary rounded-pill px-4 mt-auto">
                            Détail de la formation
                        </a>

                    </div>
                </div>
            </div>


            {# Bloc futur formations #}
            <div class="col-md-6 col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 text-center">
                    <div class="card-body d-flex flex-column p-4 p-lg-4 justify-content-center">

                        <div class="mb-3">
                            <i class="bi bi-plus-circle fs-1 text-secondary"></i>
                        </div>

                        <h5 class="fw-semibold text-dark mb-3">
                            Nouvelles formations
                        </h5>

                        <p class="text-secondary small mb-4">
                            D'autres formations seront bientôt disponibles pour approfondir
                            l'informatique, Internet et les outils numériques.
                        </p>

                        <span class="badge bg-light text-secondary border">
                            Prochainement
                        </span>

                    </div>
                </div>
            </div>

        </div>

    </div>
</section>
{% endblock %}