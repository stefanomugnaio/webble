				</div>

				{# ================= FONCTIONNALITÉS ================= #}
				<div class="titre-section-comparaison">
					Fonctionnalités et suivi
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Fonctionnalités spécifiques : blog, espace client, réservation, etc.
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
