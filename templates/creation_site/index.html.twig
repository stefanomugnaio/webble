				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Contrat de maintenance après la mise en ligne
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
						<span class="tiret-comparaison">En option</span>
					</div>

					<div class="valeur-comparaison" data-formule="Sérieuse">
						<span class="tiret-comparaison">En option + 3 mois offerts</span>
					</div>

					<div class="valeur-comparaison" data-formule="Pro">
						<span class="tiret-comparaison">En option + 6 mois offerts</span>
					</div>
				</div>


				{# Boutons répétés en bas comme sur la référence. #}
				<div class="actions-comparateur">
					<div aria-hidden="true"></div>

					<div>
						<a href="{{ path('app_devis', {'offre': 'tranquille'}) }}" class="btn bouton-tableau">
							C'est parti !
						</a>
					</div>

					<div>
						<a href="{{ path('app_devis', {'offre': 'serieuse'}) }}" class="btn bouton-tableau">
							C'est parti !
						</a>
					</div>

					<div>
						<a href="{{ path('app_contact') }}" class="btn bouton-tableau">
							Contactez-moi !
