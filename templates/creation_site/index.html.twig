{# templates/creation_site/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Formules & tarifs{% endblock %}

{% block description_seo %}
    Découvrez les formules Webble pour créer, moderniser ou faire évoluer votre site internet selon votre projet et votre budget.
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('creation_site') }}
{% endblock %}

{% block body %}
	<section class="page-tarifs min-vh-100">
		<div class="container conteneur-tarifs">

			{# ================= EN-TÊTE ================= #}
			<header class="entete-tarifs text-center mx-auto padding-top-creation-site-responsive">
				<p class="surtitre-tarifs">
					Formules
				</p>

				<h1 class="titre-principal-tarifs">
					Des offres simples, adaptées à votre budget.
				</h1>

				<p class="description-principale-tarifs">
					Choisissez le niveau d’accompagnement qui correspond à votre projet.
				</p>
			</header>

			{# ================= COMPARATEUR ================= #}
			<section class="comparateur-tarifs">

				<div class="entete-comparateur">

					<div class="colonne-libelle-vide" aria-hidden="true"></div>

					{# Offre Tranquille #}
					<article class="carte-formule carte-formule--tranquille">

						<div class="entete-carte-formule">
							<span class="badge-formule">
								{{ offres.tranquille.donnees.titre_carte }}
							</span>
						</div>

						<p class="accroche-formule">
							{{ offres.tranquille.donnees.accroche_creation_site }}
						</p>

						<div class="zone-prix-formule">
							<strong class="prix-formule">
								{{ offres.tranquille.montants.site_ht|number_format(0, ',', ' ') }}
								€
							</strong>
						</div>

						<p class="resume-formule">
							{{ offres.tranquille.donnees.resume_creation_site }}
						</p>

						<a href="{{ path('app_devis', {'offre': 'tranquille'}) }}" class="btn bouton-formule">
							C'est parti !
						</a>

					</article>

					{# Offre Sérieuse #}
					<article class="carte-formule carte-formule--serieuse">

						<div class="entete-carte-formule">
							<span class="badge-formule">
								{{ offres.serieuse.donnees.titre_carte }}
							</span>

							<div class="badges-mise-en-avant">
								<span class="badge-recommandee">
									Recommandée
								</span>

								{% if offres.serieuse.donnees.pourcentage_reduction > 0 %}
									<span class="badge-promotion">
										-{{ (offres.serieuse.donnees.pourcentage_reduction * 100)|round }}%
									</span>
								{% endif %}
							</div>
						</div>

						<p class="accroche-formule">
							{{ offres.serieuse.donnees.accroche_creation_site }}
						</p>

						<div class="zone-prix-formule">
							{% if offres.serieuse.donnees.pourcentage_reduction > 0 %}
								<span class="ancien-prix-formule">
									{{ offres.serieuse.donnees.prix_site_ht_avant_reduction|number_format(0, ',', ' ') }}
									€
								</span>
							{% endif %}

							<strong class="prix-formule">
								{{ offres.serieuse.montants.site_ht|number_format(0, ',', ' ') }}
								€
							</strong>
						</div>

						<p class="resume-formule">
							{{ offres.serieuse.donnees.resume_creation_site }}
						</p>

						<a href="{{ path('app_devis', {'offre': 'serieuse'}) }}" class="btn bouton-formule">
							C'est parti !
						</a>

					</article>

					{# Offre Pro #}
					<article class="carte-formule carte-formule--pro">

						<div class="entete-carte-formule">
							<span class="badge-formule">
								{{ offres.pro.donnees.titre_carte }}
							</span>
						</div>

						<p class="accroche-formule">
							{{ offres.pro.donnees.accroche_creation_site }}
						</p>

						<div class="zone-prix-formule">
							<strong class="prix-formule prix-formule--devis">
								{% if offres.pro.donnees.prix_site_ht is same as(null) %}
									Sur devis
								{% else %}
									{{ offres.pro.montants.site_ht|number_format(0, ',', ' ') }} €
								{% endif %}
							</strong>
						</div>

						<p class="resume-formule">
							{{ offres.pro.donnees.resume_creation_site }}
						</p>

						<a href="{{ path('app_contact') }}" class="btn bouton-formule">
							Contactez-moi !
						</a>

					</article>

				</div>

				{# ================= STRUCTURE DU SITE ================= #}
				<div class="titre-section-comparaison">
					Structure et création du site
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Design responsive sur mobile, tablette et ordinateur
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Sérieuse">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Pro">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Intégration de votre logo et de vos couleurs
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Sérieuse">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Pro">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Livraison clé en main, prête à être mise en ligne
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Sérieuse">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Pro">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Nombre de pages
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
						<span class="tiret-comparaison">1 (landing page)</span>
					</div>

					<div class="valeur-comparaison" data-formule="Sérieuse">
						<span class="tiret-comparaison">Jusqu'à 5</span>
					</div>

					<div class="valeur-comparaison" data-formule="Pro">
						<span class="tiret-comparaison">Illimité</span>
					</div>
				</div>

				{# ================= VISIBILITÉ ================= #}
				<div class="titre-section-comparaison">
					Visibilité et intégrations
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Optimisation de base pour le référencement naturel
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Sérieuse">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Pro">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Intégration de vos réseaux sociaux
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Sérieuse">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Pro">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>
				</div>

				{# ================= ADMINISTRATION ================= #}
				<div class="titre-section-comparaison">
					Administration et accompagnement
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Formation rapide à la prise en main du site
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
						<span class="tiret-comparaison">—</span>
					</div>

					<div class="valeur-comparaison" data-formule="Sérieuse">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Pro">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Espace administrateur pour la gestion du contenu
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
						<span class="tiret-comparaison">—</span>
					</div>

					<div class="valeur-comparaison" data-formule="Sérieuse">
						<span class="tiret-comparaison">Basique</span>
					</div>

					<div class="valeur-comparaison" data-formule="Pro">
						<span class="tiret-comparaison">Avancé</span>
					</div>
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Formation à la prise en main du site
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Sérieuse">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>

					<div class="valeur-comparaison" data-formule="Pro">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>
				</div>

				{# ================= FONCTIONNALITÉS ================= #}
				<div class="titre-section-comparaison">
					Fonctionnalités et suivi
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Fonctionnalités spécifiques : blog, espace client, réservation, etc.
					</div>

					<div class="valeur-comparaison" data-formule="Tranquille">
						<span class="tiret-comparaison">—</span>
					</div>

					<div class="valeur-comparaison" data-formule="Sérieuse">
						<span class="tiret-comparaison">—</span>
					</div>

					<div class="valeur-comparaison" data-formule="Pro">
						<i class="bi bi-check-circle"></i>
						<span class="texte-accessible">Inclus</span>
					</div>
				</div>

				<div class="ligne-comparaison">
					<div class="libelle-comparaison">
						Abonnement Webble+
					</div>

					{% for codeOffre, offre in offres %}
						<div class="valeur-comparaison" data-formule="{{ offre.donnees.libelle }}">
							<span class="tiret-comparaison">
								{% if offre.donnees.webble_plus_mois_offerts > 0 %}
									En option + {{ offre.donnees.webble_plus_mois_offerts }} mois offerts
								{% else %}
									En option
								{% endif %}
							</span>
						</div>
					{% endfor %}
				</div>

				{# Boutons répétés en bas #}
				<div class="actions-comparateur">
					<div aria-hidden="true"></div>

					<div>
						<a href="{{ path('app_devis', {'offre': 'tranquille'}) }}" class="btn bouton-tableau">
							C'est parti !
						</a>
					</div>

					<div>
						<a href="{{ path('app_devis', {'offre': 'serieuse'}) }}" class="btn bouton-tableau">
							C'est parti !
						</a>
					</div>

					<div>
						<a href="{{ path('app_contact') }}" class="btn bouton-tableau">
							Contactez-moi !
						</a>
					</div>
				</div>

			</section>

			{# ================= WEBBLE+ ================= #}
			<div class="lien-maintenance text-end">
				<a href="/webble-plus" class="link-secondary link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover">
					En savoir plus sur l'offre Webble+
				</a>
			</div>

			{# ================= PRESTATIONS COMPLÉMENTAIRES ================= #}
			<section class="prestations-complementaires" id="prestations-complementaires">

				<header class="entete-section text-center mx-auto">
					<p class="surtitre-tarifs">
						Prestations complémentaires
					</p>

					<h2 class="titre-section">
						Votre site web existe déjà ?
					</h2>

					<p class="description-section">
						Webble peut également moderniser un site existant ou faire évoluer un site déjà réalisé ensemble.
					</p>
				</header>

				<div class="row g-4 align-items-stretch">

					{% for prestation in prestationsComplementaires %}
						{% set classeIconeTheme = prestation.theme == 'violet' ? 'violette' : prestation.theme %}

						<div class="col-12 col-lg-6">
							<article class="carte-prestation h-100">

								<div class="entete-carte-prestation">
									<span class="badge-prestation badge-prestation--{{ prestation.theme }}">
										{{ prestation.badge }}
									</span>

									<span class="icone-prestation icone-prestation--{{ classeIconeTheme }}">
										<i class="{{ prestation.icone }}"></i>
									</span>
								</div>

								<h3 class="titre-prestation">
									{{ prestation.titre }}
								</h3>

								<p class="description-prestation">
									{{ prestation.description }}
								</p>

								{% if prestation.libelle_condition %}
									<p class="libelle-prestation">
										{{ prestation.libelle_condition }}
									</p>
								{% endif %}

								<ul class="liste-prestation">
									{% for caracteristique in prestation.caracteristiques %}
										<li>
											<i class="bi bi-check-circle"></i>
											<span>{{ caracteristique }}</span>
										</li>
									{% endfor %}
								</ul>

								<div class="pied-carte-prestation">
									<div class="prix-prestation">
										<strong>
											{{ prestation.prix_libelle }}
										</strong>

										<span>
											{{ prestation.prix_description }}
										</span>
									</div>

									<a href="{{ path(prestation.route, prestation.route_params|default({})) }}" class="btn bouton-prestation">
										{{ prestation.bouton_libelle }}
									</a>
								</div>

							</article>
						</div>
					{% endfor %}

				</div>
			</section>

			{# ================= CTA FINAL ================= #}
			<section class="appel-action-final">

				<p class="surtitre-tarifs">
					Un besoin particulier ?
				</p>

				<h2 class="titre-appel-action">
					Présentez-moi votre projet
				</h2>

				<p class="description-appel-action">
					Création, refonte ou évolution : chaque demande est étudiée pour proposer une solution claire,
					adaptée et sans fonctionnalité inutile.
				</p>

				<a href="{{ path('app_contact') }}" class="btn bouton-appel-action">
					Échanger sur mon projet
				</a>

			</section>

		</div>
	</section>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('creation_site') }}
{% endblock %}