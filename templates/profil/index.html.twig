{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('profil') }}
{% endblock %}

{% block title %}Espace client{% endblock %}

{% block body %}
<section class="py-5 min-vh-100 margin-top-responsive" style="background: #f8f9fa;">
    <div class="container py-4 py-lg-5">

        <div class="text-center mx-auto mb-5" style="max-width: 760px;">
            <p class="text-uppercase small fw-semibold text-secondary mb-2" style="letter-spacing: .08em;">
                Espace client
            </p>
            <h1 class="fw-semibold text-dark mb-3">
                Bonjour {{ client.prenom }}
            </h1>
            <p class="text-secondary mb-0">
                Retrouvez ici votre profil, vos documents, vos notifications et, selon votre rôle,
                les éléments d’administration du site.
            </p>
        </div>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-message alert alert-{{ type }} rounded-4 shadow-sm mb-4">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="row g-4 align-items-start">

            {# ============================================================ #
               COLONNE GAUCHE — MENU
               ============================================================ #}
            <div class="col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">

                        <div class="border rounded-4 bg-light p-3 mb-4">
                            <h5 class="mb-1 text-dark fw-semibold">{{ client.prenom }} {{ client.nom }}</h5>
                            <small class="text-secondary">{{ client.email }}</small>
                        </div>

                        <div class="list-group list-group-flush">

                            <a class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-3 mb-2 d-flex align-items-center gap-2 {% if section == 'profil' %}fw-semibold bg-light text-dark{% else %}text-dark{% endif %}"
                               href="{{ path('app_profil', { section: 'profil' }) }}">
                                <i class="bi bi-person"></i>
                                <span>Mon profil</span>
                            </a>

                            <a class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-3 mb-2 d-flex align-items-center gap-2 {% if section == 'documents' %}fw-semibold bg-light text-dark{% else %}text-dark{% endif %}"
                               href="{{ path('app_profil', { section: 'documents' }) }}">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>Mes documents</span>
                            </a>

                            <a class="d-none list-group-item list-group-item-action border-0 rounded-3 px-3 py-3 mb-2 d-flex align-items-center gap-2 {% if section == 'projets' %}fw-semibold bg-light text-dark{% else %}text-dark{% endif %}"
                               href="{{ path('app_profil', { section: 'projets' }) }}">
                                <i class="bi bi-gear"></i>
                                <span>Mes projets</span>
                            </a>

                            <a class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-3 mb-2 d-flex align-items-center gap-2 {% if section == 'notifications' %}fw-semibold bg-light text-dark{% else %}text-dark{% endif %}"
                               href="{{ path('app_profil', { section: 'notifications' }) }}">
                                <i class="bi bi-bell"></i>
                                <span>Notifications</span>
                            </a>

                            {% if is_granted('ROLE_ADMIN') %}
                                <hr class="my-3">

                                <a class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-3 mb-2 d-flex align-items-center gap-2 {% if section == 'messages' %}fw-semibold bg-light text-dark{% else %}text-dark{% endif %}"
                                   href="{{ path('app_profil', { section: 'messages' }) }}">
                                    <i class="bi bi-envelope"></i>
                                    <span>Messages</span>
                                </a>

                                <a class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-3 mb-2 d-flex align-items-center gap-2 {% if section == 'devis' %}fw-semibold bg-light text-dark{% else %}text-dark{% endif %}"
                                   href="{{ path('app_profil', { section: 'devis' }) }}">
                                    <i class="bi bi-file-text"></i>
                                    <span>Devis</span>
                                </a>

                                <a class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-3 mb-2 d-flex align-items-center gap-2 {% if section == 'devisFormation' %}fw-semibold bg-light text-dark{% else %}text-dark{% endif %}"
                                   href="{{ path('app_profil', { section: 'devisFormation' }) }}">
                                    <i class="bi bi-file-text"></i>
                                    <span>Devis formation</span>
                                </a>

                                <a class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-3 mb-2 d-flex align-items-center gap-2 {% if section == 'formations' %}fw-semibold bg-light text-dark{% else %}text-dark{% endif %}"
                                   href="{{ path('app_profil', { section: 'formations' }) }}">
                                    <i class="bi bi-calendar-event"></i>
                                    <span>Sessions de formation</span>
                                </a>

                                <a class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-3 mb-2 d-flex align-items-center gap-2 text-dark"
                                   href="{{ path('app_ajouter_session', { section: 'formation' }) }}">
                                    <i class="bi bi-plus-square"></i>
                                    <span>Ajouter une session de formation</span>
                                </a>
                            {% endif %}

                            <hr class="my-3">

                            <a class="list-group-item list-group-item-action border-0 rounded-3 px-3 py-3 d-flex align-items-center gap-2 text-dark"
                               href="{{ path('app_logout') }}">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Déconnexion</span>
                            </a>

                        </div>
                    </div>
                </div>
            </div>

            {# ============================================================ #
               COLONNE DROITE — CONTENU
               ============================================================ #}
            <div class="col-lg-8 col-xl-9">

                {# ====================== BLOC DOCUMENTS ====================== #}
                {% if section == 'documents' %}

                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4 p-lg-5">
                            <h5 class="mb-4 fw-semibold text-dark">
                                <i class="bi bi-file-earmark-pdf me-2"></i>
                                Mes documents
                            </h5>

                            {% if documents is not empty %}
                                <div class="list-group list-group-flush">
                                    {% for document in documents %}
                                        <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center border-bottom">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                                                <span class="text-dark">{{ document.nom }}</span>
                                            </div>

                                            <a class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                               href="{{ path('profil_document_telecharger', { id: document.id }) }}">
                                                Télécharger
                                            </a>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-secondary mb-0">Aucun document disponible.</p>
                            {% endif %}
                        </div>
                    </div>

                {# ====================== BLOC NOTIFICATIONS ====================== #}
                {% elseif section == 'notifications' %}

                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4 p-lg-5">
                            <h5 class="mb-4 fw-semibold text-dark">
                                <i class="bi bi-bell me-2"></i>
                                Notifications
                            </h5>

                            {{ form_start(formNotifications, {
                                attr: { id: 'form-notifications' }
                            }) }}

                                <div class="border rounded-4 bg-light p-4">
                                    <div class="form-check form-switch">
                                        {{ form_widget(formNotifications.notification_document, {
                                            attr: {
                                                class: 'form-check-input'
                                            }
                                        }) }}

                                        {{ form_label(formNotifications.notification_document, null, {
                                            label_attr: { class: 'form-check-label ms-2 text-dark' }
                                        }) }}
                                    </div>
                                </div>

                            {{ form_end(formNotifications) }}
                        </div>
                    </div>

                {# ====================== BLOC MESSAGES ====================== #}
                {% elseif section == 'messages' %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4 p-lg-5">

                                <h5 class="mb-4 fw-semibold text-dark">
                                    <i class="bi bi-envelope me-2"></i>
                                    Messages de contact
                                </h5>

                                {% if contacts is not empty %}
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle table-striped table-hover mb-0" style="table-layout: fixed; width: 100%;">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width: 120px;">Reçu le</th>
                                                    <th style="width: 180px;">Nom</th>
                                                    <th style="width: 240px;">Email</th>
                                                    <th style="width: 180px;">Sujet</th>
                                                    <th style="width: 450px;">Message</th>
                                                    <th style="width: 110px; text-align:center;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for contact in contacts %}
                                                    <tr>
                                                        <td>
                                                            {% if contact.dateCreation %}
                                                                {{ contact.dateCreation|date('d/m/Y') }}
                                                            {% endif %}
                                                        </td>

                                                        <td>{{ contact.prenom }} {{ contact.nom }}</td>

                                                        <td>
                                                            {% if contact.email %}
                                                                <a href="mailto:{{ contact.email }}">
                                                                    {{ contact.email }}
                                                                </a>
                                                            {% endif %}
                                                        </td>

                                                        <td>{{ contact.sujet }}</td>

                                                        <td class="small" style="word-wrap: break-word; white-space: normal;">
                                                            {{ contact.description|default('')|nl2br }}
                                                        </td>

                                                        <td class="text-center">
                                                            <form method="post"
                                                                  action="{{ path('admin_contact_delete', { id: contact.id }) }}"
                                                                  onsubmit="return confirm('Confirmer la suppression de ce message ?');">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contact.id) }}">
                                                                <button class="btn btn-sm btn-danger rounded-pill">
                                                                    🗑 Supprimer
                                                                </button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% else %}
                                    <p class="text-secondary mb-0">
                                        Aucun message de contact enregistré pour le moment.
                                    </p>
                                {% endif %}

                            </div>
                        </div>
                    {% else %}
                        <p class="text-danger">Accès non autorisé.</p>
                    {% endif %}

                {# ====================== BLOC DEVIS ====================== #}
                {% elseif section == 'devis' %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4 p-lg-5">

                                <h5 class="mb-4 fw-semibold text-dark">
                                    <i class="bi bi-file-text me-2"></i>
                                    Demandes de devis
                                </h5>

                                {% if devisList is not empty %}
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle table-striped table-hover mb-0" style="table-layout: fixed; width: 100%;">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width: 60px;">#</th>
                                                    <th style="width: 150px;">Nom</th>
                                                    <th style="width: 220px;">Email</th>
                                                    <th style="width: 140px;">Téléphone</th>
                                                    <th style="width: 200px;">Adresse</th>
                                                    <th style="width: 140px;">Ville</th>
                                                    <th style="width: 110px;">Code postal</th>
                                                    <th style="width: 400px;">Description</th>
                                                    <th style="width: 120px;">Offre</th>
                                                    <th style="width: 130px;">Contrat maint.</th>
                                                    <th style="width: 120px;">Hébergement</th>
                                                    <th style="width: 110px;">Domaine</th>
                                                    <th style="width: 80px;">RGPD</th>
                                                    <th style="width: 110px; text-align:center;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for devis in devisList %}
                                                    <tr>
                                                        <td>{{ devis.id }}</td>
                                                        <td>{{ devis.prenom }} {{ devis.nom }}</td>

                                                        <td>
                                                            {% if devis.email %}
                                                                <a href="mailto:{{ devis.email }}">
                                                                    {{ devis.email }}
                                                                </a>
                                                            {% endif %}
                                                        </td>

                                                        <td>{{ devis.telephone }}</td>
                                                        <td>{{ devis.adresse }}</td>
                                                        <td>{{ devis.ville }}</td>
                                                        <td>{{ devis.codepostal }}</td>

                                                        <td style="word-wrap: break-word; white-space: normal;">
                                                            {{ devis.description }}
                                                        </td>

                                                        <td>{{ devis.offre }}</td>

                                                        <td>
                                                            {% if devis.contratMaintenance %}
                                                                <span class="badge bg-success">Oui</span>
                                                            {% else %}
                                                                <span class="badge bg-secondary">Non</span>
                                                            {% endif %}
                                                        </td>

                                                        <td>
                                                            {% if devis.hebergement %}
                                                                <span class="badge bg-success">OK</span>
                                                            {% else %}
                                                                <span class="badge bg-danger">Non</span>
                                                            {% endif %}
                                                        </td>

                                                        <td>
                                                            {% if devis.domaine %}
                                                                <span class="badge bg-success">OK</span>
                                                            {% else %}
                                                                <span class="badge bg-danger">Non</span>
                                                            {% endif %}
                                                        </td>

                                                        <td>
                                                            {% if devis.rgpd %}
                                                                <span class="badge bg-success">OK</span>
                                                            {% else %}
                                                                <span class="badge bg-danger">Non</span>
                                                            {% endif %}
                                                        </td>

                                                        <td class="text-center">
                                                            <form method="post"
                                                                  action="{{ path('admin_devis_delete', { id: devis.id }) }}"
                                                                  onsubmit="return confirm('Confirmer la suppression de ce devis ?');">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ devis.id) }}">
                                                                <button class="btn btn-sm btn-danger rounded-pill">
                                                                    🗑 Supprimer
                                                                </button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% else %}
                                    <p class="text-secondary mb-0">
                                        Aucune demande de devis pour le moment.
                                    </p>
                                {% endif %}

                            </div>
                        </div>
                    {% else %}
                        <p class="text-danger">Accès non autorisé.</p>
                    {% endif %}

                {# ====================== BLOC DEVIS FORMATION ============= #}
                {% elseif section == 'devisFormation' %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4 p-lg-5">

                                <h5 class="mb-4 fw-semibold text-dark">
                                    <i class="bi bi-file-text me-2"></i>
                                    Demandes de formation
                                </h5>

                                {% if devisFormationList is not empty %}
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle table-striped table-hover mb-0" style="table-layout: fixed; width: 100%;">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width: 60px;">#</th>
                                                    <th style="width: 150px;">Nom</th>
                                                    <th style="width: 220px;">Email</th>
                                                    <th style="width: 140px;">Téléphone</th>
                                                    <th style="width: 200px;">Adresse</th>
                                                    <th style="width: 140px;">Ville</th>
                                                    <th style="width: 110px;">Code postal</th>
                                                    <th style="width: 400px;">Date début</th>
                                                    <th style="width: 400px;">Date fin</th>
                                                    <th style="width: 120px;">Formation</th>
                                                    <th style="width: 80px;">RGPD</th>
                                                    <th style="width: 110px; text-align:center;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for devisFormation in devisFormationList %}
                                                    <tr>
                                                        <td>{{ devisFormation.id }}</td>
                                                        <td>{{ devisFormation.prenom }} {{ devisFormation.nom }}</td>

                                                        <td>
                                                            {% if devisFormation.email %}
                                                                <a href="mailto:{{ devisFormation.email }}">
                                                                    {{ devisFormation.email }}
                                                                </a>
                                                            {% endif %}
                                                        </td>

                                                        <td>{{ devisFormation.telephone }}</td>
                                                        <td>{{ devisFormation.adresse }}</td>
                                                        <td>{{ devisFormation.ville }}</td>
                                                        <td>{{ devisFormation.codepostal }}</td>

                                                        <td style="word-wrap: break-word; white-space: normal;">
                                                            {{ devisFormation.sessionFormation.dateDebut|format_datetime(locale='fr',pattern="EEEE dd MMMM YYYY") }}
                                                        </td>

                                                        <td style="word-wrap: break-word; white-space: normal;">
                                                            {{ devisFormation.sessionFormation.dateFin|format_datetime(locale='fr',pattern="EEEE dd MMMM YYYY") }}
                                                        </td>

                                                        <td>{{ devisFormation.formations.libelle }}</td>

                                                        <td>
                                                            {% if devisFormation.rgpd %}
                                                                <span class="badge bg-success">OK</span>
                                                            {% else %}
                                                                <span class="badge bg-danger">Non</span>
                                                            {% endif %}
                                                        </td>

                                                        <td class="text-center">
                                                            <form method="post"
                                                                  action="{{ path('admin_devis_formation_delete', { id: devisFormation.id }) }}"
                                                                  onsubmit="return confirm('Confirmer la suppression de ce devis ?');">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ devisFormation.id) }}">
                                                                <button class="btn btn-sm btn-danger rounded-pill">
                                                                    🗑 Supprimer
                                                                </button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% else %}
                                    <p class="text-secondary mb-0">
                                        Aucune demande de devis pour le moment.
                                    </p>
                                {% endif %}

                            </div>
                        </div>
                    {% else %}
                        <p class="text-danger">Accès non autorisé.</p>
                    {% endif %}

                {# ====================== BLOC PROJETS ====================== #}
                {% elseif section == 'projets' %}

                    <div class="card border-0 shadow-sm rounded-4 d-none">
                        <div class="card-body p-4 p-lg-5">
                            <h5 class="mb-2 fw-semibold text-dark">
                                <i class="bi bi-gear me-2"></i>
                                Mes projets
                            </h5>
                            <p class="text-secondary mb-0">
                                Section en cours de construction.
                            </p>
                        </div>
                    </div>

                {# ====================== BLOC SESSIONS DE FORMATION ====================== #}
                {% elseif section == 'formations' %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4 p-lg-5">

                                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
                                    <h5 class="mb-0 fw-semibold text-dark">
                                        <i class="bi bi-calendar-event me-2"></i>
                                        Sessions de formation
                                    </h5>

                                    <a class="btn btn-sm btn-primary rounded-pill px-3"
                                       href="{{ path('app_ajouter_session') }}">
                                        <i class="bi bi-plus-lg me-1"></i>
                                        Ajouter une session
                                    </a>
                                </div>

                                {% if sessionsFormations is not empty %}
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle table-striped table-hover mb-0" style="table-layout: fixed; width: 100%;">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width: 70px;">#</th>
                                                    <th style="width: 140px;">Début</th>
                                                    <th style="width: 140px;">Fin</th>
                                                    <th style="width: 140px;">Heure Début</th>
                                                    <th style="width: 140px;">Heure Fin</th>
                                                    <th>Formation</th>
                                                    <th style="width: 120px; text-align:center;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for sessionF in sessionsFormations %}
                                                    {% set s = sessionF.status|lower %}
                                                    <tr>
                                                        <td>{{ sessionF.id }}</td>

                                                        <td>
                                                            {% if sessionF.dateDebut %}
                                                                {{ sessionF.dateDebut|date('d/m/Y') }}
                                                            {% else %}
                                                                <span class="text-secondary">—</span>
                                                            {% endif %}
                                                        </td>

                                                        <td>
                                                            {% if sessionF.dateFin %}
                                                                {{ sessionF.dateFin|date('d/m/Y') }}
                                                            {% else %}
                                                                <span class="text-secondary">—</span>
                                                            {% endif %}
                                                        </td>

                                                        <td>{{ sessionF.heureDebut|date('H:i') }}</td>

                                                        <td>{{ sessionF.heureFin|date('H:i') }}</td>

                                                        <td>
                                                            <span class="badge
                                                                {% if s in ['disponible', 'ouverte', 'open'] %}bg-success
                                                                {% elseif s in ['complet', 'complète', 'complete'] %}bg-warning text-dark
                                                                {% elseif s in ['annulee', 'annulée', 'annule', 'cancelled'] %}bg-danger
                                                                {% else %}bg-secondary{% endif %}">
                                                                {{ sessionF.status }}
                                                            </span>
                                                        </td>

                                                        <td style="word-wrap: break-word; white-space: normal;">
                                                            {% if sessionF.formation %}
                                                                {{ sessionF.formation.libelle ?? sessionF.formation.titre ?? sessionF.formation.nom ?? 'Formation' }}
                                                            {% else %}
                                                                <span class="text-secondary">Non liée</span>
                                                            {% endif %}
                                                        </td>

                                                        <td class="text-center">
                                                            <form method="post"
                                                                  action="{{ path('admin_session_formation_delete', { id: sessionF.id }) }}"
                                                                  onsubmit="return confirm('Confirmer la suppression de cette session ?');">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sessionF.id) }}">
                                                                <button class="btn btn-sm btn-danger rounded-pill">
                                                                    🗑
                                                                </button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% else %}
                                    <p class="text-secondary mb-0">
                                        Aucune session de formation enregistrée pour le moment.
                                    </p>
                                {% endif %}

                            </div>
                        </div>
                    {% else %}
                        <p class="text-danger">Accès non autorisé.</p>
                    {% endif %}

                {# ====================== BLOC PROFIL ====================== #}
                {% else %}

                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4 p-lg-5">

                            <h5 class="mb-4 fw-semibold text-dark">
                                <i class="bi bi-person me-2"></i>
                                Mon profil
                            </h5>

                            {{ form_start(form) }}

                                <div class="mb-3">
                                    {{ form_label(form.nom) }}
                                    {{ form_widget(form.nom, {
                                        attr: form.nom.vars.attr|merge({
                                            class: 'form-control profil-champ',
                                            readonly: true
                                        })
                                    }) }}
                                    {{ form_errors(form.nom) }}
                                </div>

                                <div class="mb-3">
                                    {{ form_label(form.prenom) }}
                                    {{ form_widget(form.prenom, {
                                        attr: form.prenom.vars.attr|merge({
                                            class: 'form-control profil-champ',
                                            readonly: true
                                        })
                                    }) }}
                                    {{ form_errors(form.prenom) }}
                                </div>

                                <div class="mb-3">
                                    {{ form_label(form.email) }}
                                    {{ form_widget(form.email, {
                                        attr: form.email.vars.attr|merge({
                                            class: 'form-control profil-champ',
                                            readonly: true
                                        })
                                    }) }}
                                    {{ form_errors(form.email) }}
                                </div>

                                <div class="mb-3">
                                    {{ form_label(form.telephone) }}
                                    {{ form_widget(form.telephone, {
                                        attr: form.telephone.vars.attr|merge({
                                            class: 'form-control profil-champ',
                                            readonly: true
                                        })
                                    }) }}
                                    {{ form_errors(form.telephone) }}
                                </div>

                                <div class="mb-4">
                                    {{ form_label(form.pays) }}
                                    {{ form_widget(form.pays, {
                                        attr: form.pays.vars.attr|merge({
                                            class: 'form-control profil-champ',
                                            readonly: true
                                        })
                                    }) }}
                                    {{ form_errors(form.pays) }}
                                </div>

                                <div class="d-flex gap-2 flex-wrap">
                                    <button id="btn-save"
                                            type="submit"
                                            class="btn btn-primary px-4 py-2 rounded-pill"
                                            disabled>
                                        Enregistrer
                                    </button>

                                    <button id="btn-edit"
                                            type="button"
                                            class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                                        Modifier
                                    </button>
                                </div>

                            {{ form_end(form) }}

                        </div>
                    </div>

                {% endif %}

            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('profil') }}
{% endblock %}